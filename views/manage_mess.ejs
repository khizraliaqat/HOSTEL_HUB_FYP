<%- include('partials/header') %>

<style>
    :root {
        --hh-bg: #071120;
        --hh-bg-soft: #0b1730;
        --hh-white: #ffffff;
        --hh-text: #0f172a;
        --hh-text-soft: #64748b;
        --hh-line: rgba(255, 255, 255, 0.12);
        --hh-primary: #0ea5e9;
        --hh-secondary: #7c3aed;
        --hh-accent: #14b8a6;
        --hh-gold: #fbbf24;
        --hh-success: #10b981;
        --hh-shadow: 0 24px 60px rgba(2, 8, 23, 0.16);
    }

    body {
        background: #f8fafc;
        font-family: 'Outfit', sans-serif;
        overflow-x: hidden;
    }

    .hh-manage-mess-page {
        background:
            radial-gradient(circle at top left, rgba(14, 165, 233, 0.16), transparent 26%),
            radial-gradient(circle at top right, rgba(124, 58, 237, 0.16), transparent 24%),
            linear-gradient(180deg, #071120 0%, #0b1730 22%, #f8fafc 22%, #f8fafc 100%);
        min-height: 100vh;
        padding: 108px 0 72px;
    }

    .hh-shell {
        width: min(1240px, calc(100% - 32px));
        margin: 0 auto;
    }

    .hh-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.14);
        color: #dbeafe;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        backdrop-filter: blur(14px);
    }

    .hh-btn,
    .hh-btn-outline,
    .hh-btn-dark,
    .hh-btn-light {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 50px;
        padding: 0 18px;
        border-radius: 16px;
        font-weight: 800;
        text-decoration: none;
        transition: all 0.25s ease;
        border: 0;
        cursor: pointer;
    }

    .hh-btn {
        background: linear-gradient(135deg, var(--hh-primary) 0%, var(--hh-secondary) 100%);
        color: #ffffff;
        box-shadow: 0 16px 32px rgba(14, 165, 233, 0.18);
    }

    .hh-btn:hover {
        transform: translateY(-2px);
        color: #ffffff;
        box-shadow: 0 22px 38px rgba(14, 165, 233, 0.22);
    }

    .hh-btn-outline,
    .hh-btn-light {
        background: #ffffff;
        border: 1px solid #dbe4f0;
        color: #0f172a;
    }

    .hh-btn-dark {
        background: #0f172a;
        color: #ffffff;
    }

    .hh-btn-outline:hover,
    .hh-btn-dark:hover,
    .hh-btn-light:hover {
        transform: translateY(-2px);
    }

    .hh-hero {
        position: relative;
        border-radius: 36px;
        overflow: hidden;
        background: linear-gradient(180deg, #0c172c 0%, #101d3a 100%);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 24px 60px rgba(2, 8, 23, 0.2);
        color: #ffffff;
        padding: 34px;
        margin-bottom: 24px;
    }

    .hh-hero::before {
        content: '';
        position: absolute;
        width: 250px;
        height: 250px;
        right: -80px;
        top: -90px;
        border-radius: 999px;
        background: rgba(251, 191, 36, 0.14);
        filter: blur(36px);
        pointer-events: none;
    }

    .hh-hero-top {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        flex-wrap: wrap;
    }

    .hh-hero-copy h1 {
        margin: 18px 0 10px;
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(2.2rem, 5vw, 3.8rem);
        line-height: 1.02;
        letter-spacing: -0.05em;
        color: #ffffff;
    }

    .hh-hero-copy h1 .accent {
        background: linear-gradient(90deg, #fde68a 0%, #fbbf24 42%, #8b5cf6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hh-hero-copy p {
        margin: 0;
        color: #c8d6f0;
        line-height: 1.85;
        max-width: 760px;
        font-size: 1rem;
    }

    .hh-hero-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-top: 26px;
        position: relative;
        z-index: 1;
    }

    .hh-stat {
        padding: 18px;
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(14px);
    }

    .hh-stat strong {
        display: block;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.5rem;
        line-height: 1;
        color: #ffffff;
        margin-bottom: 7px;
    }

    .hh-stat span {
        color: #c8d6f0;
        font-size: 0.88rem;
    }

    .hh-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.12fr) minmax(280px, 0.88fr);
        gap: 24px;
        align-items: start;
    }

    .hh-card,
    .hh-side-card {
        border-radius: 30px;
        background: #ffffff;
        border: 1px solid #e6eef8;
        box-shadow: var(--hh-shadow);
        overflow: hidden;
    }

    .hh-form-card {
        padding: 28px;
    }

    .hh-section-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0 0 18px;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.32rem;
        color: #0f172a;
    }

    .hh-section-title .icon {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, rgba(251, 191, 36, 0.14) 0%, rgba(14, 165, 233, 0.08) 100%);
        color: #0f172a;
    }

    .hh-table-wrap {
        overflow-x: auto;
        border-radius: 24px;
        border: 1px solid #e6eef8;
        background: #ffffff;
    }

    .hh-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 760px;
    }

    .hh-table thead {
        background: linear-gradient(135deg, #0ea5e9 0%, #7c3aed 100%);
        color: #ffffff;
    }

    .hh-table th,
    .hh-table td {
        padding: 14px 16px;
        text-align: center;
        border-bottom: 1px solid #edf2f7;
        vertical-align: middle;
    }

    .hh-table th {
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-weight: 800;
    }

    .hh-table td {
        color: #0f172a;
        font-size: 0.94rem;
        background: #ffffff;
    }

    .hh-table tbody tr:hover td {
        background: #f8fbff;
    }

    .hh-day-cell {
        font-weight: 800;
        font-family: 'Space Grotesk', sans-serif;
        background: #f8fafc !important;
        min-width: 120px;
    }

    .hh-field-input {
        width: 100%;
        min-height: 46px;
        border: 1px solid #dbe4f0;
        border-radius: 14px;
        background: #f8fafc;
        padding: 0 12px;
        outline: none;
        color: #0f172a;
        font-family: 'Outfit', sans-serif;
        transition: all 0.25s ease;
        text-align: center;
    }

    .hh-field-input:focus {
        border-color: #7dd3fc;
        box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.08);
        background: #ffffff;
    }

    .hh-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 22px;
    }

    .hh-side-card {
        position: sticky;
        top: 100px;
        padding: 24px;
        background: linear-gradient(180deg, #0c172c 0%, #101d3a 100%);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #ffffff;
    }

    .hh-side-card::before {
        content: '';
        position: absolute;
        width: 180px;
        height: 180px;
        right: -40px;
        top: -50px;
        border-radius: 999px;
        background: rgba(14, 165, 233, 0.16);
        filter: blur(28px);
        pointer-events: none;
    }

    .hh-side-head {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 18px;
    }

    .hh-side-icon {
        width: 56px;
        height: 56px;
        border-radius: 18px;
        display: grid;
        place-items: center;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #ffffff;
        font-size: 1.35rem;
        flex-shrink: 0;
    }

    .hh-side-head h3 {
        margin: 0 0 4px;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.2rem;
        color: #ffffff;
    }

    .hh-side-head p {
        margin: 0;
        color: #c8d6f0;
        font-size: 0.9rem;
    }

    .hh-side-points {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 12px;
    }

    .hh-point {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #dbeafe;
        font-weight: 600;
    }

    .hh-point i {
        width: 36px;
        height: 36px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: rgba(255, 255, 255, 0.08);
        color: #7dd3fc;
        flex-shrink: 0;
    }

    .hh-note {
        position: relative;
        z-index: 1;
        margin-top: 18px;
        padding: 16px;
        border-radius: 18px;
        background: rgba(251, 191, 36, 0.12);
        border: 1px solid rgba(251, 191, 36, 0.18);
        color: #fde68a;
        line-height: 1.7;
        font-size: 0.9rem;
    }

    @media (max-width: 1199px) {
        .hh-layout {
            grid-template-columns: 1fr;
        }

        .hh-side-card {
            position: static;
        }
    }

    @media (max-width: 767px) {
        .hh-manage-mess-page {
            padding: 92px 0 54px;
        }

        .hh-shell {
            width: min(100% - 20px, 1240px);
        }

        .hh-hero,
        .hh-form-card,
        .hh-side-card {
            padding: 18px;
        }

        .hh-hero-stats {
            grid-template-columns: 1fr;
        }

        .hh-table thead {
            display: none;
        }

        .hh-table,
        .hh-table tbody,
        .hh-table tr,
        .hh-table td {
            display: block;
            width: 100%;
        }

        .hh-table tr {
            padding: 14px;
            border-bottom: 1px solid #edf2f7;
        }

        .hh-table td {
            text-align: left;
            padding: 8px 0;
            border: none;
            background: transparent !important;
        }

        .hh-day-cell {
            font-size: 1rem;
            margin-bottom: 10px;
            padding-bottom: 10px !important;
            border-bottom: 1px solid #eee !important;
        }

        .hh-field-input {
            text-align: left;
        }
    }

    @media (max-width: 575px) {
        .hh-hero-copy h1 {
            font-size: 2rem;
        }

        .hh-actions,
        .hh-hero-top {
            flex-direction: column;
            align-items: stretch;
        }

        .hh-btn,
        .hh-btn-outline,
        .hh-btn-dark,
        .hh-btn-light {
            width: 100%;
        }
    }
</style>

<div class="hh-manage-mess-page">
    <div class="hh-shell">
        <section class="hh-hero">
            <div class="hh-hero-top">
                <div class="hh-hero-copy">
                    <span class="hh-badge"><i class="bi bi-egg-fried"></i> weekly mess control</span>
                    <h1>Weekly <span class="accent">mess menu</span></h1>
                    <p>Update the food schedule for your students with a cleaner premium layout. This redesign keeps the same mess-management logic, hostel ID handling, and day loop while making the page easier to use across desktop and mobile.</p>
                </div>

                <a href="/owner_dashboard" class="hh-btn-outline"><i class="bi bi-arrow-right"></i> Skip for Now</a>
            </div>

            <div class="hh-hero-stats">
                <div class="hh-stat">
                    <strong>7</strong>
                    <span>Days to manage</span>
                </div>
                <div class="hh-stat">
                    <strong>3</strong>
                    <span>Meals per day</span>
                </div>
                <div class="hh-stat">
                    <strong>Live</strong>
                    <span>Student-facing schedule</span>
                </div>
            </div>
        </section>

        <div class="hh-layout">
            <section class="hh-card">
                <div class="hh-form-card">
                    <form action="/manage_mess" method="POST">
                        <input type="hidden" name="hostel_id" value="<%= hostel_id %>">

                        <h3 class="hh-section-title"><span class="icon"><i class="bi bi-calendar-week"></i></span> Plan Weekly Meals</h3>

                        <div class="hh-table-wrap">
                            <table class="hh-table">
                                <thead>
                                    <tr>
                                        <th style="width: 15%;">Day</th>
                                        <th>Breakfast</th>
                                        <th>Lunch</th>
                                        <th>Dinner</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% 
                                    const daysOfWeek = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
                                    daysOfWeek.forEach(day => { 
                                        let current = (menu && menu[day]) || {};
                                    %>
                                        <tr>
                                            <td class="hh-day-cell">
                                                <%= day %>
                                                <input type="hidden" name="day[]" value="<%= day %>">
                                            </td>
                                            <td>
                                                <input type="text" name="breakfast[]" class="hh-field-input" placeholder="e.g. Paratha + Egg" value="<%= current.breakfast || '' %>">
                                            </td>
                                            <td>
                                                <input type="text" name="lunch[]" class="hh-field-input" placeholder="e.g. Biryani" value="<%= current.lunch || '' %>">
                                            </td>
                                            <td>
                                                <input type="text" name="dinner[]" class="hh-field-input" placeholder="e.g. Chicken Karahi" value="<%= current.dinner || '' %>">
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>

                        <div class="hh-actions">
                            <a href="/owner_dashboard" class="hh-btn-light">Cancel</a>
                            <button type="submit" class="hh-btn"><i class="bi bi-check2-circle"></i> Save Menu & Finish</button>
                        </div>
                    </form>
                </div>
            </section>

            <aside class="hh-side-card">
                <div class="hh-side-head">
                    <div class="hh-side-icon"><i class="bi bi-lightning-charge"></i></div>
                    <div>
                        <h3>Quick guidance</h3>
                        <p>Keep the menu clear, consistent, and easy to read.</p>
                    </div>
                </div>

                <div class="hh-side-points">
                    <div class="hh-point"><i class="bi bi-sunrise"></i> Add breakfast items students expect to see daily</div>
                    <div class="hh-point"><i class="bi bi-sun"></i> Use lunch entries that are short and recognizable</div>
                    <div class="hh-point"><i class="bi bi-moon-stars"></i> Keep dinner details accurate for the week ahead</div>
                    <div class="hh-point"><i class="bi bi-pencil-square"></i> Update the menu whenever the mess plan changes</div>
                </div>

                <div class="hh-note">
                    This menu is attached to the selected hostel and helps students understand the weekly food schedule before and during their stay.
                </div>
            </aside>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

</body>
</html>
<%- include('partials/header') %>

<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<style>
    :root {
        --hh-bg: #071120;
        --hh-bg-soft: #0b1730;
        --hh-white: #ffffff;
        --hh-text: #0f172a;
        --hh-text-soft: #64748b;
        --hh-line: rgba(255, 255, 255, 0.12);
        --hh-primary: #0ea5e9;
        --hh-secondary: #7c3aed;
        --hh-accent: #14b8a6;
        --hh-gold: #fbbf24;
        --hh-danger: #ef4444;
        --hh-shadow: 0 24px 60px rgba(2, 8, 23, 0.16);
    }

    body {
        background: #f8fafc;
        font-family: 'Outfit', sans-serif;
        overflow-x: hidden;
    }

    .hh-wishlist-page {
        background:
            radial-gradient(circle at top left, rgba(14, 165, 233, 0.16), transparent 26%),
            radial-gradient(circle at top right, rgba(124, 58, 237, 0.16), transparent 24%),
            linear-gradient(180deg, #071120 0%, #0b1730 22%, #f8fafc 22%, #f8fafc 100%);
        min-height: 100vh;
        padding: 108px 0 72px;
    }

    .hh-shell {
        width: min(1320px, calc(100% - 32px));
        margin: 0 auto;
    }

    .hh-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.14);
        color: #dbeafe;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        backdrop-filter: blur(14px);
    }

    .hh-btn,
    .hh-btn-outline,
    .hh-btn-dark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 50px;
        padding: 0 18px;
        border-radius: 16px;
        font-weight: 800;
        text-decoration: none;
        transition: all 0.25s ease;
        border: 0;
        cursor: pointer;
    }

    .hh-btn {
        background: linear-gradient(135deg, var(--hh-primary) 0%, var(--hh-secondary) 100%);
        color: #ffffff;
        box-shadow: 0 16px 32px rgba(14, 165, 233, 0.18);
    }

    .hh-btn:hover {
        transform: translateY(-2px);
        color: #ffffff;
        box-shadow: 0 22px 38px rgba(14, 165, 233, 0.22);
    }

    .hh-btn-outline {
        background: #ffffff;
        border: 1px solid #dbe4f0;
        color: #0f172a;
    }

    .hh-btn-dark {
        background: #0f172a;
        color: #ffffff;
    }

    .hh-btn-outline:hover,
    .hh-btn-dark:hover {
        transform: translateY(-2px);
    }

    .hh-hero {
        position: relative;
        border-radius: 36px;
        overflow: hidden;
        background: linear-gradient(180deg, #0c172c 0%, #101d3a 100%);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 24px 60px rgba(2, 8, 23, 0.2);
        color: #ffffff;
        padding: 34px;
        margin-bottom: 24px;
    }

    .hh-hero::before {
        content: '';
        position: absolute;
        width: 250px;
        height: 250px;
        right: -80px;
        top: -90px;
        border-radius: 999px;
        background: rgba(239, 68, 68, 0.14);
        filter: blur(36px);
        pointer-events: none;
    }

    .hh-hero-top {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        flex-wrap: wrap;
    }

    .hh-hero-copy h1 {
        margin: 18px 0 10px;
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(2.2rem, 5vw, 3.8rem);
        line-height: 1.02;
        letter-spacing: -0.05em;
        color: #ffffff;
    }

    .hh-hero-copy h1 .accent {
        background: linear-gradient(90deg, #ffb4b4 0%, #f87171 42%, #8b5cf6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hh-hero-copy p {
        margin: 0;
        color: #c8d6f0;
        line-height: 1.85;
        max-width: 760px;
        font-size: 1rem;
    }

    .hh-stats-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-top: 26px;
        position: relative;
        z-index: 1;
    }

    .hh-stat {
        padding: 18px;
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(14px);
    }

    .hh-stat strong {
        display: block;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.6rem;
        line-height: 1;
        color: #ffffff;
        margin-bottom: 7px;
    }

    .hh-stat span {
        color: #c8d6f0;
        font-size: 0.88rem;
    }

    .hh-section-card {
        border-radius: 30px;
        background: #ffffff;
        border: 1px solid #e6eef8;
        box-shadow: var(--hh-shadow);
        overflow: hidden;
    }

    .hh-section-head {
        padding: 22px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
        border-bottom: 1px solid #edf2f7;
        background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    }

    .hh-section-head h3 {
        margin: 0;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.3rem;
        color: #0f172a;
    }

    .hh-head-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        border-radius: 999px;
        background: #0f172a;
        color: #ffffff;
        font-size: 0.8rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .hh-section-body {
        padding: 24px;
    }

    .hh-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    .hh-card {
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid #e6eef8;
        background: #ffffff;
        box-shadow: 0 12px 26px rgba(2, 8, 23, 0.06);
        transition: all 0.3s ease;
        position: relative;
    }

    .hh-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(124, 58, 237, 0.12);
    }

    .hh-media {
        position: relative;
        height: 230px;
        overflow: hidden;
        background: #e5e7eb;
    }

    .hh-media img,
    .hh-media .placeholder-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.45s ease;
    }

    .hh-card:hover .hh-media img {
        transform: scale(1.08);
    }

    .hh-media::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.08) 0%, rgba(15, 23, 42, 0.62) 100%);
        pointer-events: none;
    }

    .hh-remove-btn {
        position: absolute;
        top: 14px;
        right: 14px;
        width: 46px;
        height: 46px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(8px);
        border: none;
        color: #dc2626;
        display: grid;
        place-items: center;
        cursor: pointer;
        transition: 0.3s ease;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.12);
        z-index: 2;
        font-size: 1.1rem;
    }

    .hh-remove-btn:hover {
        background: #dc2626;
        color: white;
        transform: rotate(90deg) scale(1.04);
    }

    .hh-price-badge {
        position: absolute;
        left: 14px;
        bottom: 14px;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(8, 17, 32, 0.88);
        color: #ffffff;
        font-size: 0.84rem;
        font-weight: 800;
        box-shadow: 0 10px 22px rgba(0, 0, 0, 0.18);
    }

    .hh-card-body {
        padding: 18px;
    }

    .hh-card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 10px;
    }

    .hh-card-top h4 {
        margin: 0;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.08rem;
        color: #0f172a;
        line-height: 1.3;
    }

    .hh-type-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 12px;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #334155;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        white-space: nowrap;
    }

    .hh-location {
        color: #64748b;
        font-size: 0.9rem;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .hh-divider {
        height: 1px;
        background: #edf2f7;
        margin: 14px 0;
    }

    .hh-card-actions {
        display: grid;
        gap: 10px;
    }

    .hh-empty {
        padding: 70px 24px;
        text-align: center;
        color: #64748b;
    }

    .hh-empty i {
        width: 88px;
        height: 88px;
        margin: 0 auto 18px;
        border-radius: 999px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.1) 0%, rgba(124, 58, 237, 0.08) 100%);
        color: #0f172a;
        font-size: 2rem;
    }

    .hh-empty h3 {
        margin: 0 0 10px;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.5rem;
        color: #0f172a;
    }

    .hh-empty p {
        margin: 0 0 20px;
        line-height: 1.8;
    }

    @media (max-width: 1199px) {
        .hh-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 767px) {
        .hh-wishlist-page {
            padding: 92px 0 54px;
        }

        .hh-shell {
            width: min(100% - 20px, 1320px);
        }

        .hh-hero,
        .hh-section-head,
        .hh-section-body,
        .hh-card-body {
            padding-left: 18px;
            padding-right: 18px;
        }

        .hh-hero,
        .hh-section-head,
        .hh-section-body,
        .hh-card-body {
            padding-top: 18px;
            padding-bottom: 18px;
        }

        .hh-stats-grid,
        .hh-grid {
            grid-template-columns: 1fr;
        }

        .hh-media {
            height: 210px;
        }

        .hh-btn,
        .hh-btn-outline,
        .hh-btn-dark {
            width: 100%;
        }
    }

    @media (max-width: 575px) {
        .hh-hero-copy h1 {
            font-size: 2rem;
        }

        .hh-card-top,
        .hh-hero-top {
            flex-direction: column;
            align-items: stretch;
        }

        .hh-remove-btn {
            width: 42px;
            height: 42px;
            top: 12px;
            right: 12px;
        }

        .hh-price-badge {
            left: 12px;
            bottom: 12px;
        }
    }
</style>

<div class="hh-wishlist-page">
    <div class="hh-shell">
        <section class="hh-hero">
            <div class="hh-hero-top">
                <div class="hh-hero-copy">
                    <span class="hh-badge"><i class="bi bi-heart-fill"></i> saved collection</span>
                    <h1>Your <span class="accent">wishlist</span></h1>
                    <p>Manage your saved hostels, compare favorite properties, and jump back into details whenever you are ready. This redesign keeps your wishlist logic intact and presents it in the same premium HostelHub design system.</p>
                </div>

                <a href="/" class="hh-btn-outline"><i class="bi bi-search"></i> Browse Hostels</a>
            </div>

            <div class="hh-stats-grid">
                <div class="hh-stat">
                    <strong><%= hostels.length %></strong>
                    <span>Saved items</span>
                </div>
                <div class="hh-stat">
                    <strong>PKR</strong>
                    <span>Local pricing kept</span>
                </div>
                <div class="hh-stat">
                    <strong>Live</strong>
                    <span>Instant remove action</span>
                </div>
            </div>
        </section>

        <section class="hh-section-card">
            <div class="hh-section-head">
                <h3><i class="bi bi-bookmark-heart me-2"></i> Saved Properties</h3>
                <span class="hh-head-pill"><%= hostels.length %> Items</span>
            </div>

            <div class="hh-section-body">
                <% if (hostels.length > 0) { %>
                    <div class="hh-grid">
                        <% hostels.forEach((row, index) => { %>
                            <div class="hh-card" data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
                                <div class="hh-media">
                                    <% if(row.image) { %>
                                        <img src="/uploads/<%= row.image %>" class="wish-img" alt="<%= row.name %>">
                                    <% } else { %>
                                        <div class="placeholder-img placeholder-hostel"></div>
                                    <% } %>

                                    <button class="hh-remove-btn" onclick="toggleWishlist(this, '<%= row._id %>')" title="Remove from Wishlist">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>

                                    <div class="hh-price-badge">Rs. <%= row.price.toLocaleString() %></div>
                                </div>

                                <div class="hh-card-body">
                                    <div class="hh-card-top">
                                        <h4><%= row.name %></h4>
                                        <span class="hh-type-badge"><%= row.category %></span>
                                    </div>

                                    <div class="hh-location">
                                        <i class="bi bi-geo-alt-fill text-warning"></i>
                                        <span><%= row.area %></span>
                                    </div>

                                    <div class="hh-divider"></div>

                                    <div class="hh-card-actions">
                                        <a href="/details/<%= row._id %>" class="hh-btn-dark">View Property</a>
                                        <button type="button" class="hh-btn-outline" onclick="toggleWishlist(this, '<%= row._id %>')">Remove from Wishlist</button>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="hh-empty" data-aos="zoom-in">
                        <i class="bi bi-heartbreak"></i>
                        <h3>Your wishlist is empty</h3>
                        <p>It looks like you have not saved any hostels yet. Start browsing and save the ones you want to revisit later.</p>
                        <a href="/" class="hh-btn" style="width:auto; min-width:220px;">Browse Hostels</a>
                    </div>
                <% } %>
            </div>
        </section>
    </div>
</div>

<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    AOS.init({ once: true, duration: 800 });

    function toggleWishlist(btn, id) {
        const card = btn.closest('[data-aos]') || btn.closest('.hh-card');
        if (card) {
            card.style.transition = 'all 0.45s ease';
            card.style.transform = 'scale(0.92)';
            card.style.opacity = '0';
        }

        setTimeout(() => {
            fetch('/toggle_wishlist', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ hostel_id: id })
            }).then(() => window.location.reload());
        }, 280);
    }
</script>

<%- include('partials/footer') %>

</body>
</html>
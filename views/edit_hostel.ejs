<%- include('partials/header') %>

<style>
    :root {
        --hh-bg: #071120;
        --hh-bg-soft: #0b1730;
        --hh-white: #ffffff;
        --hh-text: #0f172a;
        --hh-text-soft: #64748b;
        --hh-line: rgba(255, 255, 255, 0.12);
        --hh-primary: #0ea5e9;
        --hh-secondary: #7c3aed;
        --hh-accent: #14b8a6;
        --hh-gold: #fbbf24;
        --hh-danger: #ef4444;
        --hh-shadow: 0 24px 60px rgba(2, 8, 23, 0.16);
    }

    body {
        background: #f8fafc;
        font-family: 'Outfit', sans-serif;
        overflow-x: hidden;
    }

    .hh-edit-hostel-page {
        background:
            radial-gradient(circle at top left, rgba(14, 165, 233, 0.16), transparent 26%),
            radial-gradient(circle at top right, rgba(124, 58, 237, 0.16), transparent 24%),
            linear-gradient(180deg, #071120 0%, #0b1730 22%, #f8fafc 22%, #f8fafc 100%);
        min-height: 100vh;
        padding: 108px 0 72px;
    }

    .hh-shell {
        width: min(1240px, calc(100% - 32px));
        margin: 0 auto;
    }

    .hh-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.14);
        color: #dbeafe;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        backdrop-filter: blur(14px);
    }

    .hh-btn,
    .hh-btn-outline,
    .hh-btn-dark,
    .hh-btn-light {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 50px;
        padding: 0 18px;
        border-radius: 16px;
        font-weight: 800;
        text-decoration: none;
        transition: all 0.25s ease;
        border: 0;
        cursor: pointer;
    }

    .hh-btn {
        background: linear-gradient(135deg, var(--hh-primary) 0%, var(--hh-secondary) 100%);
        color: #ffffff;
        box-shadow: 0 16px 32px rgba(14, 165, 233, 0.18);
    }

    .hh-btn:hover {
        transform: translateY(-2px);
        color: #ffffff;
        box-shadow: 0 22px 38px rgba(14, 165, 233, 0.22);
    }

    .hh-btn-outline,
    .hh-btn-light {
        background: #ffffff;
        border: 1px solid #dbe4f0;
        color: #0f172a;
    }

    .hh-btn-dark {
        background: #0f172a;
        color: #ffffff;
    }

    .hh-btn-outline:hover,
    .hh-btn-dark:hover,
    .hh-btn-light:hover {
        transform: translateY(-2px);
    }

    .hh-hero {
        position: relative;
        border-radius: 36px;
        overflow: hidden;
        background: linear-gradient(180deg, #0c172c 0%, #101d3a 100%);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 24px 60px rgba(2, 8, 23, 0.2);
        color: #ffffff;
        padding: 34px;
        margin-bottom: 24px;
    }

    .hh-hero::before {
        content: '';
        position: absolute;
        width: 250px;
        height: 250px;
        right: -80px;
        top: -90px;
        border-radius: 999px;
        background: rgba(14, 165, 233, 0.14);
        filter: blur(36px);
        pointer-events: none;
    }

    .hh-hero-top {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        flex-wrap: wrap;
    }

    .hh-hero-copy h1 {
        margin: 18px 0 10px;
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(2.2rem, 5vw, 3.8rem);
        line-height: 1.02;
        letter-spacing: -0.05em;
        color: #ffffff;
    }

    .hh-hero-copy h1 .accent {
        background: linear-gradient(90deg, #8be7ff 0%, #39bdf8 42%, #8b5cf6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hh-hero-copy p {
        margin: 0;
        color: #c8d6f0;
        line-height: 1.85;
        max-width: 760px;
        font-size: 1rem;
    }

    .hh-hero-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-top: 26px;
        position: relative;
        z-index: 1;
    }

    .hh-stat {
        padding: 18px;
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(14px);
    }

    .hh-stat strong {
        display: block;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.5rem;
        line-height: 1;
        color: #ffffff;
        margin-bottom: 7px;
    }

    .hh-stat span {
        color: #c8d6f0;
        font-size: 0.88rem;
    }

    .hh-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
        gap: 24px;
        align-items: start;
    }

    .hh-card,
    .hh-side-card {
        border-radius: 30px;
        background: #ffffff;
        border: 1px solid #e6eef8;
        box-shadow: var(--hh-shadow);
        overflow: hidden;
    }

    .hh-form-card {
        padding: 28px;
    }

    .hh-section-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0 0 18px;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.32rem;
        color: #0f172a;
    }

    .hh-section-title .icon {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, rgba(14, 165, 233, 0.1) 0%, rgba(124, 58, 237, 0.08) 100%);
        color: #0f172a;
    }

    .hh-form-grid {
        display: grid;
        gap: 18px;
    }

    .hh-form-grid.two {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hh-field label {
        display: block;
        margin-bottom: 8px;
        color: #64748b;
        font-size: 0.8rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .hh-field input,
    .hh-field textarea,
    .hh-field select {
        width: 100%;
        border: 1px solid #dbe4f0;
        border-radius: 16px;
        background: #ffffff;
        padding: 14px 16px;
        outline: none;
        color: #0f172a;
        font-family: 'Outfit', sans-serif;
        transition: all 0.25s ease;
    }

    .hh-field input:focus,
    .hh-field textarea:focus,
    .hh-field select:focus {
        border-color: #7dd3fc;
        box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.08);
    }

    .hh-field textarea {
        min-height: 120px;
        resize: vertical;
    }

    .hh-facilities-box,
    .hh-upload-box {
        padding: 22px;
        border-radius: 24px;
        background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid #e6eef8;
    }

    .hh-chip-group {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 10px;
    }

    .hh-facility-input {
        display: none;
    }

    .hh-facility-label {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 14px;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid #dbe4f0;
        color: #0f172a;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.25s ease;
    }

    .hh-facility-input:checked + .hh-facility-label {
        background: #0f172a;
        color: #ffffff;
        border-color: #0f172a;
        box-shadow: 0 12px 24px rgba(2, 8, 23, 0.14);
    }

    .hh-help {
        margin-top: 8px;
        color: #64748b;
        font-size: 0.84rem;
        line-height: 1.6;
    }

    .hh-image-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 16px;
    }

    .hh-image-item {
        position: relative;
        width: 96px;
        height: 96px;
        border-radius: 18px;
        overflow: hidden;
        background: #e5e7eb;
        box-shadow: 0 10px 22px rgba(2, 8, 23, 0.08);
    }

    .hh-image-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .hh-delete-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 28px;
        height: 28px;
        border-radius: 999px;
        display: grid;
        place-items: center;
        background: rgba(239, 68, 68, 0.96);
        color: #ffffff;
        text-decoration: none;
        box-shadow: 0 10px 18px rgba(239, 68, 68, 0.18);
        transition: all 0.25s ease;
        font-size: 0.9rem;
        line-height: 1;
    }

    .hh-delete-btn:hover {
        transform: scale(1.08);
        color: #ffffff;
    }

    .hh-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 22px;
    }

    .hh-side-card {
        position: sticky;
        top: 100px;
        padding: 24px;
        background: linear-gradient(180deg, #0c172c 0%, #101d3a 100%);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #ffffff;
    }

    .hh-side-card::before {
        content: '';
        position: absolute;
        width: 180px;
        height: 180px;
        right: -40px;
        top: -50px;
        border-radius: 999px;
        background: rgba(124, 58, 237, 0.16);
        filter: blur(28px);
        pointer-events: none;
    }

    .hh-side-head {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 18px;
    }

    .hh-side-icon {
        width: 56px;
        height: 56px;
        border-radius: 18px;
        display: grid;
        place-items: center;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #ffffff;
        font-size: 1.35rem;
        flex-shrink: 0;
    }

    .hh-side-head h3 {
        margin: 0 0 4px;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.2rem;
        color: #ffffff;
    }

    .hh-side-head p {
        margin: 0;
        color: #c8d6f0;
        font-size: 0.9rem;
    }

    .hh-side-points {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 12px;
    }

    .hh-point {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #dbeafe;
        font-weight: 600;
    }

    .hh-point i {
        width: 36px;
        height: 36px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: rgba(255, 255, 255, 0.08);
        color: #7dd3fc;
        flex-shrink: 0;
    }

    .hh-note {
        position: relative;
        z-index: 1;
        margin-top: 18px;
        padding: 16px;
        border-radius: 18px;
        background: rgba(239, 68, 68, 0.12);
        border: 1px solid rgba(239, 68, 68, 0.18);
        color: #fecaca;
        line-height: 1.7;
        font-size: 0.9rem;
    }

    @media (max-width: 1199px) {
        .hh-layout,
        .hh-form-grid.two {
            grid-template-columns: 1fr;
        }

        .hh-side-card {
            position: static;
        }
    }

    @media (max-width: 767px) {
        .hh-edit-hostel-page {
            padding: 92px 0 54px;
        }

        .hh-shell {
            width: min(100% - 20px, 1240px);
        }

        .hh-hero,
        .hh-form-card,
        .hh-side-card,
        .hh-facilities-box,
        .hh-upload-box {
            padding: 18px;
        }

        .hh-hero-stats {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 575px) {
        .hh-hero-copy h1 {
            font-size: 2rem;
        }

        .hh-actions,
        .hh-hero-top {
            flex-direction: column;
            align-items: stretch;
        }

        .hh-btn,
        .hh-btn-outline,
        .hh-btn-dark,
        .hh-btn-light {
            width: 100%;
        }
    }
</style>

<div class="hh-edit-hostel-page">
    <div class="hh-shell">
        <section class="hh-hero">
            <div class="hh-hero-top">
                <div class="hh-hero-copy">
                    <span class="hh-badge"><i class="bi bi-pencil-square"></i> property editing</span>
                    <h1>Edit <span class="accent"><%= hostel.name %></span></h1>
                    <p>Update hostel details, facilities, description, map code, and images in one cleaner premium page. This redesign keeps your edit logic intact and matches the rest of the HostelHub owner dashboard system.</p>
                </div>

                <a href="/owner_dashboard" class="hh-btn-outline"><i class="bi bi-arrow-left"></i> Back to Dashboard</a>
            </div>

            <div class="hh-hero-stats">
                <div class="hh-stat">
                    <strong><%= hostel.category %></strong>
                    <span>Current category</span>
                </div>
                <div class="hh-stat">
                    <strong><%= images.length %></strong>
                    <span>Existing photos</span>
                </div>
                <div class="hh-stat">
                    <strong>PKR</strong>
                    <span>Local pricing kept</span>
                </div>
            </div>
        </section>

        <div class="hh-layout">
            <section class="hh-card">
                <div class="hh-form-card">
                    <form action="/edit_hostel/<%= hostel._id %>" method="POST" enctype="multipart/form-data">
                        <h3 class="hh-section-title"><span class="icon"><i class="bi bi-house-door"></i></span> Hostel Details</h3>

                        <div class="hh-form-grid">
                            <div class="hh-field">
                                <label>Name</label>
                                <input type="text" name="name" value="<%= hostel.name %>" required>
                            </div>
                        </div>

                        <div class="hh-form-grid two" style="margin-top:18px;">
                            <div class="hh-field">
                                <label>Category</label>
                                <select name="category" class="form-select">
                                    <option <%= hostel.category == 'Boys' ? 'selected' : '' %>>Boys</option>
                                    <option <%= hostel.category == 'Girls' ? 'selected' : '' %>>Girls</option>
                                    <option <%= hostel.category == 'Family' ? 'selected' : '' %>>Family</option>
                                </select>
                            </div>

                            <div class="hh-field">
                                <label>Area</label>
                                <input type="text" name="area" value="<%= hostel.area %>" required>
                            </div>
                        </div>

                        <div class="hh-form-grid" style="margin-top:18px;">
                            <div class="hh-field">
                                <label>Price</label>
                                <input type="number" name="price" value="<%= hostel.price %>" required>
                                <div class="hh-help">Keep the main hostel price updated in Pakistani Rupees.</div>
                            </div>
                        </div>

                        <div style="margin-top:26px;">
                            <h3 class="hh-section-title"><span class="icon"><i class="bi bi-stars"></i></span> Facilities</h3>
                            <div class="hh-facilities-box">
                                <% 
                                    const myFacs = Array.isArray(hostel.facilities) ? hostel.facilities : (hostel.facilities ? hostel.facilities.split(',') : []);
                                    const allFacs = ['WiFi', 'Mess', 'Laundry', 'Generator', 'CCTV', 'Parking'];
                                %>
                                <div class="hh-chip-group">
                                    <% allFacs.forEach(f => { %>
                                        <input type="checkbox" class="hh-facility-input" name="facilities" value="<%= f %>" id="e_<%= f %>" <%= myFacs.includes(f) ? 'checked' : '' %>>
                                        <label class="hh-facility-label" for="e_<%= f %>"><%= f %></label>
                                    <% }); %>
                                </div>
                                <div class="hh-help">Choose the facilities that are currently available for students.</div>
                            </div>
                        </div>

                        <div class="hh-form-grid" style="margin-top:26px;">
                            <div class="hh-field">
                                <label>Description</label>
                                <textarea name="desc" rows="4"><%= hostel.description %></textarea>
                            </div>

                            <div class="hh-field">
                                <label>Google Maps Code</label>
                                <textarea name="map_embed" rows="3"><%= hostel.map_embed %></textarea>
                                <div class="hh-help">Paste the Google Maps embed code used for the hostel location block.</div>
                            </div>
                        </div>

                        <div style="margin-top:26px;">
                            <h3 class="hh-section-title"><span class="icon"><i class="bi bi-images"></i></span> Photos</h3>
                            <div class="hh-upload-box">
                                <div class="hh-image-grid">
                                    <% images.forEach(function(img) { %>
                                        <div class="hh-image-item">
                                            <img src="/uploads/<%= typeof img === 'string' ? img : img.image_path %>" alt="Hostel image">
                                            <a href="/delete_image/<%= typeof img === 'string' ? img : img._id %>?hostel_id=<%= hostel._id %>" 
                                               class="hh-delete-btn" 
                                               onclick="return confirm('Delete this photo?')">×</a>
                                        </div>
                                    <% }); %>
                                </div>

                                <div class="hh-field">
                                    <input type="file" name="images" multiple>
                                    <div class="hh-help">Upload new photos to add more current visuals to the hostel listing.</div>
                                </div>
                            </div>
                        </div>

                        <div class="hh-actions">
                            <a href="/owner_dashboard" class="hh-btn-light">Cancel</a>
                            <button type="submit" class="hh-btn"><i class="bi bi-check2-circle"></i> Update Details</button>
                        </div>
                    </form>
                </div>
            </section>

            <aside class="hh-side-card">
                <div class="hh-side-head">
                    <div class="hh-side-icon"><i class="bi bi-lightning-charge"></i></div>
                    <div>
                        <h3>Quick guidance</h3>
                        <p>Keep your listing clear, current, and easy to compare.</p>
                    </div>
                </div>

                <div class="hh-side-points">
                    <div class="hh-point"><i class="bi bi-tag"></i> Keep the name simple and recognizable</div>
                    <div class="hh-point"><i class="bi bi-geo-alt"></i> Make sure the area and map code match the real location</div>
                    <div class="hh-point"><i class="bi bi-stars"></i> Select only the facilities actually available</div>
                    <div class="hh-point"><i class="bi bi-camera"></i> Remove outdated images and upload clearer ones</div>
                </div>

                <div class="hh-note">
                    Deleting an image removes it from the hostel listing immediately, so review the gallery carefully before saving changes.
                </div>
            </aside>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

</body>
</html>
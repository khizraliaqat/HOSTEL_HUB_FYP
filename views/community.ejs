<%- include('partials/header') %>

<style>
    :root {
        --hh-bg: #071120;
        --hh-bg-soft: #0b1730;
        --hh-white: #ffffff;
        --hh-text: #0f172a;
        --hh-text-soft: #64748b;
        --hh-line: rgba(255, 255, 255, 0.12);
        --hh-primary: #0ea5e9;
        --hh-secondary: #7c3aed;
        --hh-accent: #14b8a6;
        --hh-gold: #fbbf24;
        --hh-shadow: 0 24px 60px rgba(2, 8, 23, 0.25);
    }

    body {
        background: #f8fafc;
        font-family: 'Outfit', sans-serif;
    }

    .hh-community-page {
        background:
            radial-gradient(circle at top left, rgba(14, 165, 233, 0.16), transparent 26%),
            radial-gradient(circle at top right, rgba(124, 58, 237, 0.16), transparent 24%),
            linear-gradient(180deg, #071120 0%, #0b1730 22%, #f8fafc 22%, #f8fafc 100%);
        color: var(--hh-text);
        min-height: 100vh;
    }

    .hh-shell {
        width: min(1240px, calc(100% - 32px));
        margin: 0 auto;
    }

    .hh-section {
        padding: 92px 0;
    }

    .hh-section-tight {
        padding: 72px 0;
    }

    .hh-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.14);
        color: #dbeafe;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        backdrop-filter: blur(14px);
    }

    .hh-section-heading {
        max-width: 760px;
        margin: 0 auto 52px;
        text-align: center;
    }

    .hh-section-heading h2 {
        margin: 12px 0 12px;
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(2rem, 4vw, 3.4rem);
        line-height: 1.06;
        letter-spacing: -0.04em;
        color: #0f172a;
    }

    .hh-section-heading p {
        margin: 0;
        color: var(--hh-text-soft);
        font-size: 1rem;
        line-height: 1.85;
        font-family: 'Outfit', sans-serif;
    }

    .hh-community-hero {
        position: relative;
        padding: 108px 0 58px;
        overflow: hidden;
    }

    .hh-community-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.02fr) minmax(420px, 0.98fr);
        gap: 34px;
        align-items: center;
    }

    .hh-community-copy {
        color: #ffffff;
        position: relative;
        z-index: 2;
    }

    .hh-community-copy h1 {
        margin: 18px 0 18px;
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(3rem, 7vw, 5.1rem);
        line-height: 0.98;
        letter-spacing: -0.055em;
        color: #ffffff;
        max-width: 720px;
    }

    .hh-community-copy h1 .accent {
        background: linear-gradient(90deg, #8be7ff 0%, #39bdf8 42%, #8b5cf6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hh-community-copy p {
        max-width: 620px;
        margin: 0 0 26px;
        color: #c8d6f0;
        font-size: 1.08rem;
        line-height: 1.9;
    }

    .hh-community-points {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        max-width: 620px;
    }

    .hh-community-point {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 18px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(14px);
        color: #e2ecff;
        font-weight: 600;
    }

    .hh-community-point i {
        width: 40px;
        height: 40px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        background: rgba(255, 255, 255, 0.08);
        color: #7dd3fc;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .hh-community-visual {
        position: relative;
        min-height: 600px;
    }

    .hh-orb,
    .hh-orb-2 {
        position: absolute;
        border-radius: 999px;
        filter: blur(60px);
        z-index: 0;
    }

    .hh-orb {
        width: 180px;
        height: 180px;
        left: -20px;
        top: 60px;
        background: rgba(14, 165, 233, 0.22);
    }

    .hh-orb-2 {
        width: 210px;
        height: 210px;
        right: -10px;
        bottom: 10px;
        background: rgba(124, 58, 237, 0.24);
    }

    .hh-showcase {
        position: relative;
        z-index: 1;
        min-height: 600px;
        border-radius: 38px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: #081120;
        box-shadow: var(--hh-shadow);
    }

    .hh-showcase img {
        width: 100%;
        height: 600px;
        object-fit: cover;
        display: block;
    }

    .hh-showcase::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(7, 17, 32, 0.08) 0%, rgba(7, 17, 32, 0.52) 55%, rgba(7, 17, 32, 0.92) 100%);
    }

    .hh-floating-card,
    .hh-floating-bottom {
        position: absolute;
        z-index: 2;
        border-radius: 26px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(8, 17, 32, 0.62);
        color: #ffffff;
        backdrop-filter: blur(16px);
        box-shadow: 0 18px 38px rgba(2, 8, 23, 0.32);
    }

    .hh-floating-card {
        top: 22px;
        left: 22px;
        right: 22px;
        padding: 20px;
    }

    .hh-floating-card small {
        display: block;
        color: #c3d4f1;
        margin-bottom: 5px;
    }

    .hh-floating-card h3 {
        margin: 0 0 10px;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.45rem;
    }

    .hh-inline-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        color: #dbeafe;
        font-size: 0.92rem;
    }

    .hh-inline-meta span {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .hh-floating-bottom {
        left: 22px;
        right: 22px;
        bottom: 22px;
        padding: 20px;
    }

    .hh-floating-bottom h4 {
        margin: 0 0 12px;
        font-size: 1.08rem;
        color: #ffffff;
    }

    .hh-mini-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .hh-mini-grid div {
        padding: 14px;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.07);
        color: #dbeafe;
        font-size: 0.88rem;
        line-height: 1.6;
    }

    .hh-filter-bar {
        margin-top: 16px;
        border-radius: 32px;
        padding: 18px;
        background: #ffffff;
        border: 1px solid #e6eef8;
        box-shadow: 0 18px 36px rgba(15, 23, 42, 0.06);
    }

    .hh-filter-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .hh-filter-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .hh-filter-pills button {
        padding: 10px 16px;
        border-radius: 999px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #475569;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .hh-filter-pills button.active {
        background: #0f172a;
        color: #ffffff;
        border-color: #0f172a;
    }

    .hh-filter-note {
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 600;
    }

    .hh-card-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 24px;
    }

    .hh-room-card {
        border-radius: 30px;
        background: #ffffff;
        border: 1px solid #e6eef8;
        box-shadow: 0 18px 36px rgba(15, 23, 42, 0.06);
        overflow: hidden;
        transition: transform 0.28s ease, box-shadow 0.28s ease;
        position: relative;
    }

    .hh-room-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 24px 42px rgba(15, 23, 42, 0.1);
    }

    .hh-room-media {
        position: relative;
        height: 230px;
        overflow: hidden;
        background: #dbeafe;
    }

    .hh-room-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.45s ease;
    }

    .hh-room-card:hover .hh-room-media img {
        transform: scale(1.06);
    }

    .hh-room-media::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.08) 0%, rgba(15, 23, 42, 0.66) 100%);
    }

    .hh-room-chip,
    .hh-room-online {
        position: absolute;
        z-index: 2;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 700;
    }

    .hh-room-chip {
        top: 16px;
        left: 16px;
        padding: 9px 14px;
        background: rgba(255, 255, 255, 0.94);
        color: #0f172a;
    }

    .hh-room-online {
        right: 16px;
        bottom: 16px;
        padding: 10px 14px;
        background: rgba(8, 17, 32, 0.88);
        color: #ffffff;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.12);
    }

    .hh-room-body {
        padding: 24px;
    }

    .hh-room-title-row {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        align-items: flex-start;
        margin-bottom: 10px;
    }

    .hh-room-body h3 {
        margin: 0;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.26rem;
        line-height: 1.3;
        color: #0f172a;
    }

    .hh-room-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 12px;
        border-radius: 999px;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: 0.82rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .hh-room-body p {
        margin: 0 0 18px;
        color: #64748b;
        line-height: 1.8;
        font-size: 0.95rem;
    }

    .hh-room-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 18px;
    }

    .hh-room-meta span {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 12px;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #334155;
        font-size: 0.84rem;
        font-weight: 600;
    }

    .hh-room-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        height: 50px;
        border-radius: 16px;
        text-decoration: none;
        font-weight: 800;
        background: linear-gradient(135deg, var(--hh-primary) 0%, var(--hh-secondary) 100%);
        color: #ffffff;
        box-shadow: 0 16px 32px rgba(14, 165, 233, 0.16);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .hh-room-btn:hover {
        transform: translateY(-2px);
        color: #ffffff;
        box-shadow: 0 20px 36px rgba(14, 165, 233, 0.22);
    }

    .hh-cta-wrap {
        border-radius: 36px;
        background: linear-gradient(135deg, #0c172c 0%, #1f3b78 100%);
        box-shadow: var(--hh-shadow);
        overflow: hidden;
        position: relative;
    }

    .hh-cta-wrap::before {
        content: '';
        position: absolute;
        inset: auto auto -120px -120px;
        width: 280px;
        height: 280px;
        border-radius: 999px;
        background: rgba(14, 165, 233, 0.14);
        filter: blur(20px);
    }

    .hh-cta-wrap::after {
        content: '';
        position: absolute;
        top: -100px;
        right: -100px;
        width: 260px;
        height: 260px;
        border-radius: 999px;
        background: rgba(124, 58, 237, 0.18);
        filter: blur(20px);
    }

    .hh-cta-content {
        position: relative;
        z-index: 1;
        padding: 42px;
        display: flex;
        justify-content: space-between;
        gap: 20px;
        align-items: center;
        flex-wrap: wrap;
    }

    .hh-cta-copy h2 {
        margin: 0 0 12px;
        font-family: 'Space Grotesk', sans-serif;
        color: #ffffff;
        font-size: clamp(1.9rem, 4vw, 3rem);
        line-height: 1.08;
        letter-spacing: -0.04em;
    }

    .hh-cta-copy p {
        margin: 0;
        color: #d6e5ff;
        line-height: 1.85;
        font-size: 1rem;
    }

    .hh-btn-row {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
    }

    .hh-btn,
    .hh-btn-outline {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-width: 180px;
        height: 54px;
        padding: 0 26px;
        border-radius: 999px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.25s ease;
        border: 0;
    }

    .hh-btn {
        background: #ffffff;
        color: #0f172a;
        box-shadow: 0 14px 30px rgba(2, 8, 23, 0.18);
    }

    .hh-btn:hover {
        transform: translateY(-2px);
        color: #0f172a;
    }

    .hh-btn-outline {
        background: transparent;
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.24);
    }

    .hh-btn-outline:hover {
        transform: translateY(-2px);
        color: #ffffff;
        background: rgba(255, 255, 255, 0.08);
    }

    @media (max-width: 1199px) {
        .hh-community-grid,
        .hh-card-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .hh-community-grid {
            grid-template-columns: 1fr;
        }

        .hh-community-visual,
        .hh-showcase,
        .hh-showcase img {
            min-height: auto;
            height: 560px;
        }
    }

    @media (max-width: 991px) {
        .hh-community-points,
        .hh-mini-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 767px) {
        .hh-community-page {
            background:
                radial-gradient(circle at top left, rgba(14, 165, 233, 0.16), transparent 20%),
                radial-gradient(circle at top right, rgba(124, 58, 237, 0.16), transparent 18%),
                linear-gradient(180deg, #071120 0%, #0b1730 18%, #f8fafc 18%, #f8fafc 100%);
        }

        .hh-shell {
            width: min(100% - 22px, 1240px);
        }

        .hh-community-hero {
            padding: 92px 0 54px;
        }

        .hh-showcase,
        .hh-showcase img {
            height: 500px;
            min-height: 500px;
        }

        .hh-floating-card,
        .hh-floating-bottom {
            left: 16px;
            right: 16px;
        }

        .hh-card-grid {
            grid-template-columns: 1fr;
        }

        .hh-cta-content {
            padding: 26px;
        }

        .hh-section,
        .hh-section-tight {
            padding: 72px 0;
        }
    }

    @media (max-width: 575px) {
        .hh-community-copy h1 {
            font-size: 2.35rem;
        }

        .hh-community-copy p,
        .hh-section-heading p,
        .hh-cta-copy p {
            font-size: 0.96rem;
        }

        .hh-showcase,
        .hh-showcase img {
            height: 460px;
            min-height: 460px;
        }

        .hh-room-body,
        .hh-cta-content {
            padding: 20px;
        }
    }
</style>

<div class="hh-community-page">
    <section class="hh-community-hero">
        <div class="hh-shell hh-community-grid">
            <div class="hh-community-copy">
                <span class="hh-badge"><i class="bi bi-people"></i> community hub</span>
                <h1>Join local <span class="accent">discussion rooms</span></h1>
                <p>Select an area and enter a dedicated community space where students can connect, ask questions, share living advice, and make more informed decisions before choosing a hostel or flat.</p>

                <div class="hh-community-points">
                    <div class="hh-community-point">
                        <i class="bi bi-chat-dots-fill"></i>
                        <span>Area-based rooms</span>
                    </div>
                    <div class="hh-community-point">
                        <i class="bi bi-people-fill"></i>
                        <span>Student discussion</span>
                    </div>
                    <div class="hh-community-point">
                        <i class="bi bi-lightning-charge-fill"></i>
                        <span>Quick access</span>
                    </div>
                    <div class="hh-community-point">
                        <i class="bi bi-shield-check"></i>
                        <span>More informed choices</span>
                    </div>
                </div>
            </div>

            <div class="hh-community-visual">
                <div class="hh-orb"></div>
                <div class="hh-orb-2"></div>
                <div class="hh-showcase">
                    <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?q=80&w=1200" alt="Students in community discussion">

                    <div class="hh-floating-card">
                        <small>Built for real local discovery</small>
                        <h3>A cleaner community page with stronger visual hierarchy</h3>
                        <div class="hh-inline-meta">
                            <span><i class="bi bi-geo-alt"></i> Area-focused rooms</span>
                            <span><i class="bi bi-chat-square-text"></i> Easier entry flow</span>
                        </div>
                    </div>

                    <div class="hh-floating-bottom">
                        <h4>What this redesign improves</h4>
                        <div class="hh-mini-grid">
                            <div>Stronger hero and page identity</div>
                            <div>Better room cards with richer context</div>
                            <div>More premium and consistent design system</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="hh-section-tight">
        <div class="hh-shell">
            <div class="hh-filter-bar">
                <div class="hh-filter-inner">
                    <div class="hh-filter-pills">
                        <button type="button" class="hh-filter-btn active" data-filter="all">All rooms</button>
                        <button type="button" class="hh-filter-btn" data-filter="popular">Popular areas</button>
                        <button type="button" class="hh-filter-btn" data-filter="student">Student zones</button>
                        <button type="button" class="hh-filter-btn" data-filter="general">General discussion</button>
                    </div>
                    <div class="hh-filter-note">Choose a room and join the discussion instantly</div>
                </div>
            </div>
        </div>
    </section>

    <section class="hh-section">
        <div class="hh-shell">
            <div class="hh-section-heading">
                <span class="hh-badge" style="background:#eef6ff; color:#1d4ed8; border-color:#dbeafe;"><i class="bi bi-grid"></i> chat rooms</span>
                <h2>Explore local areas and join the right room</h2>
                <p>Your original community page had the right idea. This version gives each room more presence, better spacing, and a cleaner path into the chat experience.</p>
            </div>

            <% const areas = [
                { name: "D-Ground", img: "https://images.unsplash.com/photo-1494526585095-c41746248156?auto=format&fit=crop&w=1200&q=80", members: "128 active", vibe: "Central area", tag: "Popular" },
                { name: "Kohinoor", img: "https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1200&q=80", members: "94 active", vibe: "Student living", tag: "Trending" },
                { name: "Peoples Colony", img: "https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1200&q=80", members: "76 active", vibe: "Residential", tag: "Verified" },
                { name: "Madina Town", img: "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=1200&q=80", members: "112 active", vibe: "High demand", tag: "Popular" },
                { name: "Satyana Road", img: "https://images.unsplash.com/photo-1460317442991-0ec209397118?auto=format&fit=crop&w=1200&q=80", members: "63 active", vibe: "Growing zone", tag: "New" },
                { name: "Canal Road", img: "https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1200&q=80", members: "88 active", vibe: "Connected area", tag: "Active" },
                { name: "General Discussion", img: "https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=1200&q=80", members: "210 active", vibe: "Open topics", tag: "Open" }
            ]; %>

            <div class="hh-card-grid">
                <% areas.forEach((area) => { %>
                    <% const areaFilters = ['all']; %>
                    <% if (area.name === 'General Discussion') { %>
                        <% areaFilters.push('general'); %>
                    <% } else { %>
                        <% areaFilters.push('student'); %>
                    <% } %>
                    <% if (['Popular', 'Trending', 'Active'].includes(area.tag)) { %>
                        <% areaFilters.push('popular'); %>
                    <% } %>

                    <div class="hh-room-card" data-filters="<%= areaFilters.join(' ') %>">
                        <div class="hh-room-media">
                            <img src="<%= area.img %>" alt="<%= area.name %>">
                            <span class="hh-room-chip"><%= area.tag %></span>
                            <span class="hh-room-online"><%= area.members %></span>
                        </div>
                        <div class="hh-room-body">
                            <div class="hh-room-title-row">
                                <h3><%= area.name %></h3>
                                <span class="hh-room-badge"><i class="bi bi-people-fill"></i> Room</span>
                            </div>
                            <p>Join the <%= area.name %> discussion room to ask questions, connect with other students, and learn more about hostels and living conditions in this area.</p>
                            <div class="hh-room-meta">
                                <span><i class="bi bi-geo-alt"></i> <%= area.vibe %></span>
                                <span><i class="bi bi-chat-dots"></i> Local discussion</span>
                            </div>
                            <a href="/area_chat?area=<%= encodeURIComponent(area.name) %>" class="hh-room-btn">
                                Join Room <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

    <section class="hh-section-tight">
        <div class="hh-shell">
            <div class="hh-cta-wrap">
                <div class="hh-cta-content">
                    <div class="hh-cta-copy">
                        <h2>Want a broader conversation space?</h2>
                        <p>Use the General Discussion room to ask cross-area questions, compare neighborhoods, and learn from other students before making your next move.</p>
                    </div>
                    <div class="hh-btn-row">
                        <a href="/area_chat?area=<%= encodeURIComponent('General Discussion') %>" class="hh-btn">Open general room</a>
                        <a href="/" class="hh-btn-outline">Browse hostels</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script>
    (function setupCommunityFilters() {
        const buttons = document.querySelectorAll('.hh-filter-btn');
        const cards = document.querySelectorAll('.hh-room-card[data-filters]');

        if (!buttons.length || !cards.length) {
            return;
        }

        function applyFilter(filterKey) {
            buttons.forEach((btn) => {
                btn.classList.toggle('active', btn.dataset.filter === filterKey);
            });

            cards.forEach((card) => {
                const filters = String(card.dataset.filters || '');
                const visible = filterKey === 'all' || filters.split(' ').includes(filterKey);
                card.style.display = visible ? '' : 'none';
            });
        }

        buttons.forEach((btn) => {
            btn.addEventListener('click', function () {
                applyFilter(this.dataset.filter || 'all');
            });
        });
    })();
</script>


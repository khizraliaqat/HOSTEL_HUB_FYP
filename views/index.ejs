<div id="compareDock" class="hh-compare-dock" style="display:none;">
    <small id="compareDockText">Select two hostels to compare.</small>
    <a id="compareNowBtn" href="/compare" class="hh-card-btn hh-compare-btn">Compare Now</a>
    <button type="button" id="compareClearBtn" class="hh-card-btn hh-card-btn-outline hh-compare-btn" onclick="clearCompare()">Clear</button>
</div>

<script>
    const COMPARE_KEY = 'hhCompareHostels';

    function applyQuickFilter(values) {
        const form = document.getElementById('heroSearchForm');
        if (!form) return;

        const areaInput = form.querySelector('input[name="area"]');
        const categorySelect = form.querySelector('select[name="category"]');
        const priceInput = form.querySelector('input[name="price"]');

        if (values.area !== undefined && areaInput) areaInput.value = values.area;
        if (values.category !== undefined && categorySelect) categorySelect.value = values.category;
        if (values.price !== undefined && priceInput) priceInput.value = values.price;

        form.submit();
    }

    function toggleWishlist(event, button) {
        if (event) event.preventDefault();

        const hostelId = button.getAttribute('data-hostel-id');
        if (!hostelId) return;

        fetch('/toggle_wishlist', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ hostel_id: hostelId })
        })
            .then((response) => response.text())
            .then((result) => {
                if (result === 'login_required') {
                    window.location.href = '/login?msg=' + encodeURIComponent('Please login to use wishlist');
                    return;
                }

                if (result === 'added') {
                    setWishlistState(hostelId, true);
                    return;
                }

                if (result === 'removed') {
                    setWishlistState(hostelId, false);
                }
            })
            .catch((error) => {
                console.error('Wishlist toggle error:', error);
            });
    }

    function setWishlistState(hostelId, isActive) {
        const nodes = document.querySelectorAll('.hh-wishlist-btn[data-hostel-id="' + hostelId + '"], .hh-favorite-toggle[data-hostel-id="' + hostelId + '"]');
        nodes.forEach((node) => {
            node.classList.toggle('active', isActive);

            const icon = node.querySelector('i');
            const label = node.querySelector('span');

            if (icon && node.classList.contains('hh-wishlist-btn')) {
                icon.className = isActive ? 'bi bi-heart-fill' : 'bi bi-heart';
            }

            if (icon && node.classList.contains('hh-favorite-toggle')) {
                if (icon.classList.contains('bi-heart') || icon.classList.contains('bi-heart-fill')) {
                    icon.className = isActive ? 'bi bi-heart-fill' : 'bi bi-heart';
                }
            }

            if (label && node.classList.contains('hh-favorite-toggle')) {
                if (label.textContent === 'Favorite' || label.textContent === 'Favorited') {
                    label.textContent = isActive ? 'Favorited' : 'Favorite';
                }
            }
        });
    }

    function getCompareList() {
        try {
            const raw = localStorage.getItem(COMPARE_KEY);
            const list = raw ? JSON.parse(raw) : [];
            return Array.isArray(list) ? list : [];
        } catch (error) {
            return [];
        }
    }

    function saveCompareList(list) {
        localStorage.setItem(COMPARE_KEY, JSON.stringify(list));
    }

    function toggleCompare(button) {
        const hostelId = button.getAttribute('data-hostel-id');
        const hostelName = button.getAttribute('data-hostel-name') || 'Hostel';
        if (!hostelId) return;

        const list = getCompareList();
        const existingIndex = list.findIndex((row) => String(row.id) === String(hostelId));

        if (existingIndex >= 0) {
            list.splice(existingIndex, 1);
        } else {
            if (list.length >= 2) {
                list.shift();
            }
            list.push({ id: hostelId, name: hostelName });
        }

        saveCompareList(list);
        refreshCompareUI();
    }

    function clearCompare() {
        saveCompareList([]);
        refreshCompareUI();
    }

    function refreshCompareUI() {
        const list = getCompareList();
        const compareDock = document.getElementById('compareDock');
        const compareText = document.getElementById('compareDockText');
        const compareNowBtn = document.getElementById('compareNowBtn');

        document.querySelectorAll('.hh-compare-toggle').forEach((btn) => {
            const id = btn.getAttribute('data-hostel-id');
            const selected = list.some((row) => String(row.id) === String(id));
            btn.classList.toggle('active', selected);
            const label = btn.querySelector('span');
            if (label) {
                label.textContent = selected ? 'Added' : 'Compare';
            }
        });

        if (!compareDock || !compareText || !compareNowBtn) {
            return;
        }

        compareDock.style.display = list.length > 0 ? 'flex' : 'none';

        if (list.length < 2) {
            compareText.textContent = 'Select ' + (2 - list.length) + ' more hostel to compare.';
            compareNowBtn.setAttribute('disabled', 'disabled');
            compareNowBtn.removeAttribute('href');
            return;
        }

        compareText.textContent = list[0].name + ' vs ' + list[1].name;
        compareNowBtn.removeAttribute('disabled');
        compareNowBtn.href = '/compare?h1=' + encodeURIComponent(list[0].id) + '&h2=' + encodeURIComponent(list[1].id);
    }

    document.addEventListener('DOMContentLoaded', refreshCompareUI);
</script>


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HostelHub - Premium</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/placeholders.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --hh-white: #ffffff;
            --hh-text: #0f172a;
            --hh-text-soft: #64748b;
            --hh-line: rgba(15, 23, 42, 0.08);
            --hh-primary: #0ea5e9;
            --hh-primary-dark: #0369a1;
            --hh-secondary: #7c3aed;
            --hh-accent: #14b8a6;
            --hh-shadow: 0 20px 50px rgba(2, 8, 23, 0.12);
        }

        #global-loader {
            position: fixed;
            inset: 0;
            background: linear-gradient(135deg, #0ea5e9 0%, #7c3aed 100%);
            z-index: 99999;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            transition: opacity 0.5s ease;
        }

        .hh-loader-ring {
            width: 84px;
            height: 84px;
            border: 4px solid rgba(255, 255, 255, 0.18);
            border-top: 4px solid #14b8a6;
            border-radius: 50%;
            animation: hhSpin 1s linear infinite;
            margin-bottom: 22px;
        }

        .hh-loader-brand {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 30px;
            font-weight: 700;
            animation: hhPulse 1.5s infinite;
            color: #ffffff;
            letter-spacing: -0.04em;
        }

        .hh-loader-brand span {
            color: #c4b5fd;
        }

        @keyframes hhSpin {
            100% { transform: rotate(360deg); }
        }

        @keyframes hhPulse {
            50% { opacity: 0.65; }
        }

        body {
            padding-top: 64px;
        }

        .hh-navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 2000;
            padding: 5px 0;
            background: #ffffff;
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid rgba(15, 23, 42, 0.06);
            box-shadow: 0 8px 18px rgba(2, 8, 23, 0.045);
        }

        .hh-navbar .navbar-nav .hh-nav-link,
        .hh-navbar .navbar-nav .hh-nav-link.dropdown-toggle,
        .hh-navbar .hh-user-toggle {
            color: #0f172a !important;
        }

        .hh-navbar .hh-user-meta strong {
            color: #0f172a !important;
        }

        .hh-navbar .hh-user-meta span {
            color: #64748b !important;
        }

        .hh-navbar .hh-dropdown {
            background: #ffffff !important;
            z-index: 2100;
        }

        .hh-navbar .hh-dropdown .dropdown-item {
            color: #0f172a !important;
        }

        .hh-navbar .hh-dropdown .dropdown-item.text-danger {
            color: #dc2626 !important;
        }

        .hh-navbar-shell {
            width: min(1380px, calc(100% - 20px));
            margin: 0 auto;
        }

        .hh-brand {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            color: var(--hh-primary);
            text-decoration: none;
            letter-spacing: -0.04em;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin-right: 18px;
            flex-shrink: 0;
        }

        .hh-brand:hover {
            color: var(--hh-primary);
        }

        .hh-brand-dot {
            width: 8px;
            height: 8px;
            border-radius: 999px;
            background: linear-gradient(135deg, var(--hh-primary) 0%, var(--hh-secondary) 100%);
            box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.12);
        }

        .hh-toggler {
            border: 0;
            background: rgba(14, 165, 233, 0.1);
            border-radius: 14px;
            padding: 10px 13px;
            box-shadow: none !important;
        }

        .hh-toggler i {
            font-size: 1.35rem;
            color: var(--hh-primary);
        }

        .hh-nav-links {
            align-items: center;
            gap: 2px;
        }

        .hh-nav-link,
        .hh-nav-link.dropdown-toggle {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            min-height: 30px;
            padding: 0 10px !important;
            border-radius: 999px;
            font-family: 'Outfit', sans-serif;
            font-weight: 600;
            font-size: 0.84rem;
            color: var(--hh-text) !important;
            transition: all 0.25s ease;
        }

        .hh-nav-link:hover,
        .hh-nav-link:focus,
        .hh-nav-link.dropdown-toggle:hover,
        .hh-nav-link.dropdown-toggle:focus {
            background: rgba(14, 165, 233, 0.08);
            color: var(--hh-primary) !important;
        }

        .hh-nav-link.active {
            background: linear-gradient(135deg, rgba(14, 165, 233, 0.12) 0%, rgba(124, 58, 237, 0.1) 100%);
            color: var(--hh-primary) !important;
        }

        .hh-role-toggle::after,
        .hh-user-toggle::after {
            margin-left: 8px;
        }

        .hh-dropdown {
            border: 1px solid #e6eef8;
            border-radius: 14px;
            box-shadow: 0 16px 30px rgba(2, 8, 23, 0.09);
            padding: 6px;
            min-width: 200px;
            overflow: hidden;
            margin-top: 8px;
        }

        .hh-dropdown .dropdown-item {
            border-radius: 12px;
            padding: 10px 12px;
            font-family: 'Outfit', sans-serif;
            font-size: 0.92rem;
            font-weight: 500;
            color: var(--hh-text);
            transition: all 0.2s ease;
        }

        .hh-dropdown .dropdown-item:hover,
        .hh-dropdown .dropdown-item:focus {
            background: #f8fbff;
            color: var(--hh-primary);
        }

        .hh-dropdown .dropdown-header {
            font-family: 'Outfit', sans-serif;
            padding: 8px 12px;
        }

        .hh-dropdown .dropdown-divider {
            margin: 8px 0;
            opacity: 0.08;
        }

        .hh-navbar-actions {
            align-items: center;
            gap: 10px;
        }

        .hh-chat-link {
            position: relative;
            width: 34px;
            height: 34px;
            border-radius: 999px;
            display: grid !important;
            place-items: center;
            color: var(--hh-text) !important;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            text-decoration: none;
            transition: all 0.25s ease;
        }

        .hh-chat-link:hover {
            background: rgba(14, 165, 233, 0.08);
            color: var(--hh-primary) !important;
            transform: translateY(-1px);
        }

        .hh-chat-badge {
            position: absolute;
            top: -2px;
            right: -2px;
            min-width: 18px;
            height: 18px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #ef4444;
            color: #ffffff;
            font-size: 0.65rem;
            font-weight: 800;
            padding: 0 5px;
            box-shadow: 0 8px 18px rgba(239, 68, 68, 0.26);
        }

        .hh-user-toggle {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            color: var(--hh-text);
            padding: 2px 9px 2px 2px !important;
            border-radius: 999px;
            border: 1px solid #e2e8f0;
            background: #ffffff;
            transition: all 0.25s ease;
            min-height: 38px;
        }

        .hh-user-toggle:hover,
        .hh-user-toggle:focus {
            background: #f8fbff;
            color: var(--hh-primary);
        }

        .hh-user-avatar {
            width: 30px;
            height: 30px;
            border-radius: 999px;
            border: 2px solid var(--hh-primary);
            object-fit: cover;
            flex-shrink: 0;
            box-shadow: 0 6px 14px rgba(14, 165, 233, 0.16);
        }

        .hh-user-meta {
            display: none;
            line-height: 1.1;
        }

        .hh-user-meta strong {
            display: block;
            font-family: 'Outfit', sans-serif;
            font-size: 0.78rem;
            color: var(--hh-text);
        }

        .hh-user-meta span {
            display: block;
            font-family: 'Outfit', sans-serif;
            font-size: 0.56rem;
            color: var(--hh-text-soft);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-top: 1px;
        }

        .hh-auth-btn {
            min-height: 32px;
            padding: 0 14px;
            border-radius: 999px;
            border: 0;
            font-family: 'Outfit', sans-serif;
            font-size: 0.9rem;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            white-space: nowrap;
            transition: all 0.25s ease;
        }

        .hh-auth-btn.primary {
            background: linear-gradient(135deg, var(--hh-primary) 0%, var(--hh-primary-dark) 100%);
            color: #ffffff;
            border: 1px solid rgba(3, 105, 161, 0.18);
            box-shadow: 0 14px 28px rgba(14, 165, 233, 0.18);
        }

        .hh-auth-btn.secondary {
            background: linear-gradient(135deg, var(--hh-accent) 0%, #0f9f93 100%);
            color: #ffffff;
            border: 1px solid rgba(15, 159, 147, 0.2);
            box-shadow: 0 14px 28px rgba(20, 184, 166, 0.16);
        }

        .hh-auth-btn:hover {
            transform: translateY(-2px);
            color: #ffffff;
        }

        @media (min-width: 992px) {
            .hh-user-meta {
                display: block;
            }

            .hh-navbar .container-fluid {
                display: flex;
                align-items: center;
                flex-wrap: nowrap;
                gap: 14px;
            }

            .hh-navbar .navbar-collapse {
                display: flex !important;
                align-items: center;
                justify-content: space-between;
                flex-basis: auto;
                flex-grow: 1;
                flex-wrap: nowrap;
                min-width: 0;
            }

            .hh-nav-links {
                flex-wrap: nowrap;
                white-space: nowrap;
                margin: 0 auto;
            }

            .hh-navbar-actions {
                margin-left: auto;
                flex-shrink: 0;
                flex-wrap: nowrap;
            }
        }

        @media (max-width: 991.98px) {
            body {
                padding-top: 66px;
            }

            .hh-navbar {
                padding: 5px 0;
            }

            .hh-navbar-shell {
                width: min(100% - 16px, 1380px);
            }

            #navbarContent {
                margin-top: 8px;
                padding: 10px;
                border-radius: 16px;
                background: rgba(255, 255, 255, 0.96);
                border: 1px solid rgba(15, 23, 42, 0.06);
                box-shadow: 0 18px 42px rgba(2, 8, 23, 0.08);
            }

            .hh-nav-links {
                gap: 8px;
            }

            .hh-navbar-actions {
                margin-top: 8px;
                justify-content: flex-start;
                flex-wrap: wrap;
            }

            .hh-user-toggle {
                padding-right: 12px !important;
            }
        }
    </style>
</head>
<body>

<div id="global-loader">
    <div class="hh-loader-ring"></div>
    <div class="hh-loader-brand">Hostel<span>Hub</span></div>
</div>

<nav class="navbar navbar-expand-lg hh-navbar">
    <div class="hh-navbar-shell">
        <div class="container-fluid px-0">
            <a class="navbar-brand hh-brand" href="/">
                <span class="hh-brand-dot"></span>
                <span>HostelHub</span>
            </a>

            <button class="navbar-toggler hh-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 hh-nav-links">
                    <li class="nav-item">
                        <a class="nav-link hh-nav-link" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link hh-nav-link" href="/about">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link hh-nav-link" href="/contact">Contact</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link hh-nav-link" href="/community">Community</a>
                    </li>

                    <% if (user && user.role === 'student') { %>
                        <li class="nav-item dropdown">
                            <a class="nav-link hh-nav-link hh-role-toggle dropdown-toggle" href="#" id="studentDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Student
                            </a>
                            <ul class="dropdown-menu hh-dropdown" aria-labelledby="studentDropdown">
                                <li><a class="dropdown-item" href="/student_dashboard">Dashboard</a></li>
                                <li><a class="dropdown-item" href="/my_bookings">My Bookings</a></li>
                                <li><a class="dropdown-item" href="/my_wishlist">My Wishlist</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="/chat_list">
                                        Messages
                                        <span class="badge bg-danger ms-2 js-unread-badge" style="<%= locals.unreadCount > 0 ? '' : 'display: none;' %>"><%= locals.unreadCount %></span>
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/profile">Profile</a></li>
                            </ul>
                        </li>
                    <% } %>

                    <% if (user && user.role === 'owner') { %>
                        <li class="nav-item dropdown">
                            <a class="nav-link hh-nav-link hh-role-toggle dropdown-toggle" href="#" id="ownerDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Owner
                            </a>
                            <ul class="dropdown-menu hh-dropdown" aria-labelledby="ownerDropdown">
                                <li><a class="dropdown-item" href="/owner_dashboard">Dashboard</a></li>
                                <li><a class="dropdown-item" href="/add_hostel">Add Hostel</a></li>
                                <li><a class="dropdown-item" href="/owner_complaints">Complaints</a></li>
                                <li><a class="dropdown-item" href="/manage_hostel">Manage Hostels</a></li>
                                <li><a class="dropdown-item" href="/payment_settings">Payment Settings</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="/chat_list">
                                        Messages
                                        <span class="badge bg-danger ms-2 js-unread-badge" style="<%= locals.unreadCount > 0 ? '' : 'display: none;' %>"><%= locals.unreadCount %></span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    <% } %>

                    <% if (user && user.role === 'admin') { %>
                        <li class="nav-item dropdown">
                            <a class="nav-link hh-nav-link hh-role-toggle dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Admin
                            </a>
                            <ul class="dropdown-menu hh-dropdown" aria-labelledby="adminDropdown">
                                <li><a class="dropdown-item" href="/admin_dashboard">Admin Panel</a></li>
                            </ul>
                        </li>
                    <% } %>
                </ul>

                <div class="navbar-nav ms-lg-auto d-flex hh-navbar-actions">
                    <% if (user) { %>
                        <% if (user.role === 'owner' || user.role === 'student') { %>
                            <a href="/chat_list" class="hh-chat-link" title="Messages">
                                <i class="bi bi-chat-dots fs-5"></i>
                                <span class="hh-chat-badge js-unread-badge" style="<%= locals.unreadCount > 0 ? '' : 'display: none;' %>"><%= locals.unreadCount %></span>
                            </a>
                        <% } %>

                        <div class="nav-item dropdown">
                            <a href="#" class="nav-link dropdown-toggle hh-user-toggle" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="<%= (user.profile_pic && user.profile_pic !== 'default.png') ? '/uploads/' + user.profile_pic : 'https://ui-avatars.com/api/?name=' + user.name + '&background=0ea5e9&color=fff' %>" class="hh-user-avatar" alt="Profile">
                                <span class="hh-user-meta">
                                    <strong><%= user.name %></strong>
                                    <span><%= user.role.toUpperCase() %></span>
                                </span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end hh-dropdown" aria-labelledby="userDropdown">
                                <li><h6 class="dropdown-header">@<%= user.name %></h6></li>
                                <li><small class="dropdown-header text-muted"><%= user.role.toUpperCase() %></small></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/profile">My Profile</a></li>
                                <% if (user.role === 'owner' || user.role === 'student') { %>
                                    <li><a class="dropdown-item" href="/chat_list">Messages</a></li>
                                <% } %>
                                <% if (user.role !== 'owner') { %>
                                    <li><a class="dropdown-item" href="/community">Community</a></li>
                                <% } %>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="/logout">Logout</a></li>
                            </ul>
                        </div>
                    <% } else { %>
                        <a href="/login" class="hh-auth-btn primary">Login</a>
                        <a href="/register" class="hh-auth-btn secondary">Register</a>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</nav>

<script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
<script>
    function setupHeaderDropdownFallback() {
        if (document.body && document.body.dataset.hhDropdownFallbackReady === '1') {
            return;
        }
        if (document.body) {
            document.body.dataset.hhDropdownFallbackReady = '1';
        }

        const toggles = document.querySelectorAll('.hh-navbar .dropdown > .dropdown-toggle');
        if (!toggles.length) return;

        const closeAllMenus = function () {
            document.querySelectorAll('.hh-navbar .dropdown > .dropdown-toggle').forEach(function (toggleEl) {
                toggleEl.setAttribute('aria-expanded', 'false');
                const parent = toggleEl.closest('.dropdown');
                const menu = parent ? parent.querySelector('.dropdown-menu') : null;
                if (parent) parent.classList.remove('show');
                if (menu) menu.classList.remove('show');
            });
        };

        toggles.forEach(function (toggleEl) {
            if (toggleEl.dataset.hhFallbackBound === '1') return;
            toggleEl.dataset.hhFallbackBound = '1';

            toggleEl.addEventListener('click', function (event) {
                event.preventDefault();

                const parent = toggleEl.closest('.dropdown');
                const menu = parent ? parent.querySelector('.dropdown-menu') : null;
                if (!parent || !menu) return;

                const isOpen = menu.classList.contains('show');
                closeAllMenus();

                if (!isOpen) {
                    parent.classList.add('show');
                    menu.classList.add('show');
                    toggleEl.setAttribute('aria-expanded', 'true');
                }
            });
        });

        document.addEventListener('click', function (event) {
            if (!event.target.closest('.hh-navbar .dropdown')) {
                closeAllMenus();
            }
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
                closeAllMenus();
            }
        });
    }

    window.addEventListener('load', function () {
        const loader = document.getElementById('global-loader');
        if (loader) {
            loader.style.opacity = '0';
            setTimeout(() => {
                loader.style.display = 'none';
            }, 500);
        }

        if (typeof bootstrap === 'undefined' || !bootstrap.Dropdown) {
            setupHeaderDropdownFallback();
        }
    });

    document.addEventListener('DOMContentLoaded', function () {
        if (typeof bootstrap !== 'undefined' && bootstrap.Dropdown) {
            document.querySelectorAll('.hh-navbar .dropdown-toggle').forEach(function (dropdownToggleEl) {
                bootstrap.Dropdown.getOrCreateInstance(dropdownToggleEl, {
                    autoClose: true,
                    popperConfig: function (defaultBsPopperConfig) {
                        return defaultBsPopperConfig;
                    }
                });
            });
        } else {
            setupHeaderDropdownFallback();
        }
    });

    <% if (user) { %>
    // Poll for unread messages every 2 seconds
    setInterval(async () => {
        try {
            const response = await fetch('/api/unread_count');
            const data = await response.json();
            
            document.querySelectorAll('.js-unread-badge').forEach(badge => {
                if (data.count > 0) {
                    // Update count
                    badge.textContent = data.count;
                    // For the sidebar badge (it might just be a red dot without text), we show it
                    if (badge.classList.contains('p-1')) {
                        badge.textContent = ''; // keep dot empty
                    }
                    badge.style.display = 'inline-block';
                } else {
                    badge.style.display = 'none';
                }
            });
        } catch (err) {
            console.error('Error fetching unread count:', err);
        }
    }, 2000);
    <% } %>
</script>
<!-- header.ejs ends here; page content and footer will supply closing tags -->

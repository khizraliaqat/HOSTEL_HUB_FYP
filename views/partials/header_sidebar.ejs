<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HostelHub - Premium</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/placeholders.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">

    <style>
        /* MODERN LOADER */
        #global-loader { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(135deg, #0066CC 0%, #7C3AED 100%); z-index: 99999; display: flex; justify-content: center; align-items: center; flex-direction: column; transition: opacity 0.5s; }
        .loader-ring { width: 80px; height: 80px; border: 4px solid rgba(255, 255, 255, 0.2); border-top: 4px solid #00B8A9; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 20px; }
        .loader-brand { font-family: 'Space Grotesk', sans-serif; font-size: 28px; font-weight: 700; animation: pulse 1.5s infinite; color: white; letter-spacing: -0.5px; }
        .loader-brand span { color: #00B8A9; }
        @keyframes spin { 100% { transform: rotate(360deg); } }
        @keyframes pulse { 50% { opacity: 0.6; } }

        /* SIDEBAR */
        .sidebar { height: 100vh; width: 280px; position: fixed; top: 0; left: -320px; background: var(--dark-bg); padding-top: 90px; overflow-y: auto; transition: 0.4s cubic-bezier(0.4, 0, 0.2, 1); z-index: 1040; box-shadow: 8px 0 24px rgba(0,0,0,0.15); }
        .sidebar.active { left: 0; }
        
        /* NAV PROFILE IMAGE */
        .nav-profile-img { width: 42px; height: 42px; object-fit: cover; border: 2px solid var(--primary); border-radius: 50%; transition: all 0.3s ease; cursor: pointer; }
        .nav-profile-img:hover { transform: scale(1.08); box-shadow: 0 4px 12px rgba(0, 102, 204, 0.25); }
    </style>
</head>
<body>

<div id="global-loader">
    <div class="loader-ring"></div>
    <div class="loader-brand">Hostel<span>Hub</span></div>
</div>

<!-- HEADER -->
<div class="premium-header">
    <div class="d-flex align-items-center gap-3">
        <i class="bi bi-list menu-trigger me-2" onclick="toggleSidebar()" style="font-size: 24px; color: var(--dark-text); cursor: pointer; transition: 0.2s;"></i>
        <a href="/" style="font-family: 'Space Grotesk', sans-serif; font-size: 22px; font-weight: 700; color: var(--primary); text-decoration: none; letter-spacing: -0.5px;">HostelHub</a>
    </div>
    
    <!-- RIGHT SIDE (Fixed Alignment) -->
    <div class="d-flex align-items-center gap-2">
        <% if (user) { %>
            <!-- Profile Pic -->
            <a href="/profile" title="My Profile">
                <img src="<%= (user.profile_pic && user.profile_pic !== 'default.png') ? '/uploads/' + user.profile_pic : 'https://ui-avatars.com/api/?name=' + user.name + '&background=0066CC&color=fff' %>" 
                     class="nav-profile-img" alt="Profile">
            </a>
            <!-- Logout Button -->
            <a href="/logout" class="btn btn-sm rounded-pill px-3" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; border: none; font-weight: 600; font-family: 'Outfit', sans-serif; font-size: 13px; display: flex; align-items: center; gap: 5px; height: 36px; line-height: 1;">
                <i class="bi bi-box-arrow-right" style="font-size: 14px;"></i> <span style="white-space: nowrap;">Logout</span>
            </a>
        <% } else { %>
            <!-- Login Button -->
            <a href="/login" class="btn btn-sm rounded-pill px-4" style="background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); color: white; border: none; font-weight: 600; font-family: 'Outfit', sans-serif; font-size: 13px; display: flex; align-items: center; gap: 6px; height: 36px; line-height: 1;">
                <i class="bi bi-box-arrow-in-right" style="font-size: 14px;"></i> <span>Login</span>
            </a>
        <% } %>
    </div>
</div>

<!-- SIDEBAR -->
<div class="sidebar" id="sidebar">
    <div class="text-center mb-3 px-3">
        <% if (user) { %>
            <img src="<%= (user.profile_pic && user.profile_pic !== 'default.png') ? '/uploads/' + user.profile_pic : 'https://ui-avatars.com/api/?name=' + user.name + '&background=0066CC&color=fff' %>" 
                 class="rounded-circle mb-2" style="width: 70px; height: 70px; object-fit: cover; border: 3px solid var(--primary); box-shadow: var(--shadow-md);">
            <h6 class="text-white mb-1 fw-bold" style="font-family: 'Outfit', sans-serif; font-size: 15px;">@<%= user.name %></h6>
            <small class="text-white-50" style="font-family: 'Outfit', sans-serif; font-size: 12px; letter-spacing: 0.5px;"><%= user.role.toUpperCase() %></small>
        <% } else { %>
            <h4 class="text-white" style="font-family: 'Space Grotesk', sans-serif; font-weight: 700;">MENU</h4>
        <% } %>
    </div>

    <div class="px-3 py-2" style="border-top: 1px solid rgba(255,255,255,0.1);">
        <a href="/" style="font-family: 'Outfit', sans-serif;"><i class="bi bi-house me-2"></i> <span>Home</span></a>
        <a href="/about" style="font-family: 'Outfit', sans-serif;"><i class="bi bi-info-circle me-2"></i> <span>About Us</span></a>
        <a href="/contact" style="font-family: 'Outfit', sans-serif;"><i class="bi bi-envelope me-2"></i> <span>Contact Us</span></a>
        <a href="/community" style="font-family: 'Outfit', sans-serif;"><i class="bi bi-people-fill me-2"></i> <span>Community</span></a>
        
        <% if (user) { %>
            <a href="/profile" style="font-family: 'Outfit', sans-serif;"><i class="bi bi-person-circle me-2"></i> <span>My Profile</span></a>
        <% } %>
    </div>

    <hr class="border-secondary my-3 mx-3" style="opacity: 0.2;">

    <% if (user && user.role === 'student') { %>
        <div class="px-3">
            <small class="text-muted ms-1 mb-2 d-block" style="font-family: 'Outfit', sans-serif; font-weight: 600; letter-spacing: 0.5px;">STUDENT</small>
            <a href="/student_dashboard" style="font-family: 'Outfit', sans-serif;"><i class="bi bi-calendar-check me-2"></i> <span>Dashboard</span></a>
            <a href="/chat_list" style="font-family: 'Outfit', sans-serif;"><i class="bi bi-chat-dots me-2"></i> <span>Messages</span>
                <span class="badge bg-danger rounded-circle p-1 js-unread-badge" style="<%= locals.unreadCount > 0 ? '' : 'display: none;' %>"></span>
            </a>
        </div>
    <% } %>

    <% if (user && user.role === 'owner') { %>
        <div class="px-3">
            <small class="text-muted ms-1 mb-2 d-block" style="font-family: 'Outfit', sans-serif; font-weight: 600; letter-spacing: 0.5px;">OWNER</small>
            <a href="/owner_dashboard" style="font-family: 'Outfit', sans-serif;"><i class="bi bi-speedometer2 me-2"></i> <span>Dashboard</span></a>
            <a href="/add_hostel" style="font-family: 'Outfit', sans-serif;"><i class="bi bi-plus-lg me-2"></i> <span>Add Hostel</span></a>
            <a href="/chat_list" style="font-family: 'Outfit', sans-serif;"><i class="bi bi-chat-dots me-2"></i> <span>Messages</span>
                <span class="badge bg-danger rounded-circle p-1 js-unread-badge" style="<%= locals.unreadCount > 0 ? '' : 'display: none;' %>"></span>
            </a>
        </div>
    <% } %>

    <% if (user && user.role === 'admin') { %>
        <div class="px-3">
            <small class="text-muted ms-1 mb-2 d-block" style="font-family: 'Outfit', sans-serif; font-weight: 600; letter-spacing: 0.5px;">ADMIN</small>
            <a href="/admin_dashboard" style="font-family: 'Outfit', sans-serif;"><i class="bi bi-shield-lock me-2"></i> <span>Admin Panel</span></a>
        </div>
    <% } %>
</div>

<div class="sidebar-overlay" id="overlay" onclick="toggleSidebar()"></div>

<script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
<script>
    function toggleSidebar() {
        document.getElementById('sidebar').classList.toggle('active');
        document.getElementById('overlay').classList.toggle('active');
    }
    window.addEventListener("load", function () {
        document.getElementById("global-loader").style.opacity = "0"; 
        setTimeout(() => { document.getElementById("global-loader").style.display = "none"; }, 500);
    });
</script>
<!-- header_sidebar ends here; page content and footer will supply closing tags -->
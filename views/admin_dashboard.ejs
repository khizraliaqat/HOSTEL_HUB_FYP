<%- include('partials/header') %>

<style>
    :root {
        --hh-bg: #071120;
        --hh-bg-soft: #0b1730;
        --hh-white: #ffffff;
        --hh-text: #0f172a;
        --hh-text-soft: #64748b;
        --hh-line: rgba(255, 255, 255, 0.12);
        --hh-primary: #0ea5e9;
        --hh-secondary: #7c3aed;
        --hh-accent: #14b8a6;
        --hh-gold: #fbbf24;
        --hh-success: #10b981;
        --hh-danger: #ef4444;
        --hh-warning: #f59e0b;
        --hh-shadow: 0 24px 60px rgba(2, 8, 23, 0.16);
    }

    body {
        background: #f8fafc;
        font-family: 'Outfit', sans-serif;
        overflow-x: hidden;
    }

    .hh-admin-page {
        background:
            radial-gradient(circle at top left, rgba(14, 165, 233, 0.16), transparent 26%),
            radial-gradient(circle at top right, rgba(124, 58, 237, 0.16), transparent 24%),
            linear-gradient(180deg, #071120 0%, #0b1730 22%, #f8fafc 22%, #f8fafc 100%);
        min-height: 100vh;
        padding: 108px 0 72px;
    }

    .hh-shell {
        width: min(1320px, calc(100% - 32px));
        margin: 0 auto;
    }

    .hh-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.14);
        color: #dbeafe;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        backdrop-filter: blur(14px);
    }

    .hh-btn,
    .hh-btn-outline,
    .hh-btn-dark,
    .hh-btn-danger,
    .hh-btn-success,
    .hh-btn-warning {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 44px;
        padding: 0 16px;
        border-radius: 14px;
        font-weight: 800;
        text-decoration: none;
        transition: all 0.25s ease;
        border: 0;
        cursor: pointer;
        white-space: nowrap;
    }

    .hh-btn {
        background: linear-gradient(135deg, var(--hh-primary) 0%, var(--hh-secondary) 100%);
        color: #ffffff;
        box-shadow: 0 14px 28px rgba(14, 165, 233, 0.18);
    }

    .hh-btn:hover {
        transform: translateY(-2px);
        color: #ffffff;
        box-shadow: 0 18px 34px rgba(14, 165, 233, 0.22);
    }

    .hh-btn-outline {
        background: #ffffff;
        border: 1px solid #dbe4f0;
        color: #0f172a;
    }

    .hh-btn-dark {
        background: #0f172a;
        color: #ffffff;
    }

    .hh-btn-danger {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: #ffffff;
    }

    .hh-btn-success {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #ffffff;
    }

    .hh-btn-warning {
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
        color: #111827;
    }

    .hh-btn-outline:hover,
    .hh-btn-dark:hover,
    .hh-btn-danger:hover,
    .hh-btn-success:hover,
    .hh-btn-warning:hover {
        transform: translateY(-2px);
    }

    .hh-hero {
        position: relative;
        border-radius: 36px;
        overflow: hidden;
        background: linear-gradient(180deg, #0c172c 0%, #101d3a 100%);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 24px 60px rgba(2, 8, 23, 0.2);
        color: #ffffff;
        padding: 34px;
        margin-bottom: 24px;
    }

    .hh-hero::before {
        content: '';
        position: absolute;
        width: 260px;
        height: 260px;
        right: -80px;
        top: -90px;
        border-radius: 999px;
        background: rgba(14, 165, 233, 0.14);
        filter: blur(36px);
        pointer-events: none;
    }

    .hh-hero-top {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        flex-wrap: wrap;
    }

    .hh-hero-copy h1 {
        margin: 18px 0 10px;
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(2.2rem, 5vw, 3.8rem);
        line-height: 1.02;
        letter-spacing: -0.05em;
        color: #ffffff;
    }

    .hh-hero-copy h1 .accent {
        background: linear-gradient(90deg, #8be7ff 0%, #39bdf8 42%, #8b5cf6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hh-hero-copy p {
        margin: 0;
        color: #c8d6f0;
        line-height: 1.85;
        max-width: 760px;
        font-size: 1rem;
    }

    .hh-stats-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-top: 26px;
        position: relative;
        z-index: 1;
    }

    .hh-stat {
        padding: 18px;
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(14px);
    }

    .hh-stat strong {
        display: block;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.7rem;
        line-height: 1;
        color: #ffffff;
        margin-bottom: 7px;
    }

    .hh-stat span {
        color: #c8d6f0;
        font-size: 0.88rem;
    }

    .hh-grid {
        display: grid;
        gap: 22px;
    }

    .hh-card {
        border-radius: 30px;
        background: #ffffff;
        border: 1px solid #e6eef8;
        box-shadow: var(--hh-shadow);
        overflow: hidden;
    }

    .hh-card-head {
        padding: 22px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
        border-bottom: 1px solid #edf2f7;
        background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    }

    .hh-card-head h3 {
        margin: 0;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.3rem;
        color: #0f172a;
    }

    .hh-head-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        border-radius: 999px;
        background: #0f172a;
        color: #ffffff;
        font-size: 0.8rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .hh-card-body {
        padding: 24px;
    }

    .hh-table-wrap {
        overflow-x: auto;
        border-radius: 24px;
        border: 1px solid #e6eef8;
        background: #ffffff;
    }

    .hh-table {
        width: 100%;
        min-width: 760px;
        border-collapse: collapse;
    }

    .hh-table thead {
        background: linear-gradient(135deg, #0ea5e9 0%, #7c3aed 100%);
        color: #ffffff;
    }

    .hh-table th,
    .hh-table td {
        padding: 16px 18px;
        text-align: left;
        border-bottom: 1px solid #edf2f7;
        vertical-align: middle;
    }

    .hh-table th {
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-weight: 800;
    }

    .hh-table td {
        color: #0f172a;
        font-size: 0.94rem;
        background: #ffffff;
    }

    .hh-table tbody tr:hover td {
        background: #f8fbff;
    }

    .hh-user-chip {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .hh-avatar {
        width: 42px;
        height: 42px;
        border-radius: 999px;
        background: linear-gradient(135deg, rgba(14, 165, 233, 0.12) 0%, rgba(124, 58, 237, 0.1) 100%);
        color: #0f172a;
        display: grid;
        place-items: center;
        font-weight: 800;
        flex-shrink: 0;
    }

    .hh-user-chip strong {
        display: block;
        color: #0f172a;
        margin-bottom: 3px;
    }

    .hh-user-chip small {
        color: #64748b;
    }

    .hh-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .hh-status.verified {
        background: rgba(16, 185, 129, 0.12);
        color: #047857;
    }

    .hh-status.pending {
        background: rgba(245, 158, 11, 0.14);
        color: #b45309;
    }

    .hh-role {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 7px 12px;
        border-radius: 999px;
        background: #f1f5f9;
        color: #334155;
        font-size: 0.78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .hh-empty {
        padding: 70px 24px;
        text-align: center;
        color: #64748b;
    }

    .hh-empty i {
        width: 88px;
        height: 88px;
        margin: 0 auto 18px;
        border-radius: 999px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, rgba(14, 165, 233, 0.1) 0%, rgba(124, 58, 237, 0.08) 100%);
        color: #0f172a;
        font-size: 2rem;
    }

    .hh-empty h3,
    .hh-empty h4 {
        margin: 0 0 10px;
        font-family: 'Space Grotesk', sans-serif;
        color: #0f172a;
    }

    .hh-empty p {
        margin: 0;
        line-height: 1.8;
    }

    @media (max-width: 767px) {
        .hh-admin-page {
            padding: 92px 0 54px;
        }

        .hh-shell {
            width: min(100% - 20px, 1320px);
        }

        .hh-hero,
        .hh-card-head,
        .hh-card-body {
            padding-left: 18px;
            padding-right: 18px;
        }

        .hh-hero,
        .hh-card-head,
        .hh-card-body {
            padding-top: 18px;
            padding-bottom: 18px;
        }

        .hh-stats-grid {
            grid-template-columns: 1fr;
        }

        .hh-table thead {
            display: none;
        }

        .hh-table,
        .hh-table tbody,
        .hh-table tr,
        .hh-table td {
            display: block;
            width: 100%;
        }

        .hh-table tr {
            padding: 14px;
            border-bottom: 1px solid #edf2f7;
        }

        .hh-table td {
            text-align: left !important;
            padding: 8px 0;
            border: none;
            background: transparent !important;
        }

        .hh-btn,
        .hh-btn-outline,
        .hh-btn-dark,
        .hh-btn-danger,
        .hh-btn-success,
        .hh-btn-warning {
            width: 100%;
        }
    }

    @media (max-width: 575px) {
        .hh-hero-copy h1 {
            font-size: 2rem;
        }

        .hh-card-head,
        .hh-hero-top {
            flex-direction: column;
            align-items: stretch;
        }
    }
</style>

<div class="hh-admin-page">
    <div class="hh-shell">
        <section class="hh-hero">
            <div class="hh-hero-top">
                <div class="hh-hero-copy">
                    <span class="hh-badge"><i class="bi bi-shield-lock"></i> admin control center</span>
                    <h1>Platform <span class="accent">oversight</span></h1>
                    <p>Monitor users, verify hostels, and manage platform records from one cleaner premium admin dashboard. This redesign keeps your stats, hostel verification flow, and user deletion logic intact.</p>
                </div>
            </div>

            <div class="hh-stats-grid">
                <div class="hh-stat">
                    <strong><%= stats.totalUsers %></strong>
                    <span>Total users</span>
                </div>
                <div class="hh-stat">
                    <strong><%= stats.totalHostels %></strong>
                    <span>Total hostels</span>
                </div>
                <div class="hh-stat">
                    <strong><%= stats.totalBookings %></strong>
                    <span>Total bookings</span>
                </div>
            </div>
        </section>

        <div class="hh-grid">
            <section class="hh-card">
                <div class="hh-card-head">
                    <h3><i class="bi bi-patch-check-fill me-2"></i> Manage Hostels</h3>
                    <span class="hh-head-pill">Verification</span>
                </div>

                <div class="hh-card-body">
                    <% if (hostels.length > 0) { %>
                        <div class="hh-table-wrap">
                            <table class="hh-table">
                                <thead>
                                    <tr>
                                        <th>Hostel</th>
                                        <th>Owner</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% hostels.forEach(h => { %>
                                        <tr>
                                            <td>
                                                <div class="hh-user-chip">
                                                    <div class="hh-avatar"><%= h.name.charAt(0).toUpperCase() %></div>
                                                    <div>
                                                        <strong><%= h.name %></strong>
                                                        <small>Property listing</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><%= h.owner_name %></td>
                                            <td>
                                                <% if(h.is_verified) { %>
                                                    <span class="hh-status verified">Verified</span>
                                                <% } else { %>
                                                    <span class="hh-status pending">Pending</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if(!h.is_verified) { %>
                                                    <a href="/admin/verify_hostel/<%= h._id %>" class="hh-btn-success" style="min-height:40px; padding:0 14px;">Verify</a>
                                                <% } else { %>
                                                    <span class="hh-status verified"><i class="bi bi-check-circle-fill me-1"></i> Done</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="hh-empty">
                            <i class="bi bi-buildings"></i>
                            <h4>No hostels found</h4>
                            <p>There are no hostel records available right now.</p>
                        </div>
                    <% } %>
                </div>
            </section>

            <section class="hh-card">
                <div class="hh-card-head">
                    <h3><i class="bi bi-people-fill me-2"></i> Manage Users</h3>
                    <span class="hh-head-pill">Accounts</span>
                </div>

                <div class="hh-card-body">
                    <% if (users.length > 0) { %>
                        <div class="hh-table-wrap">
                            <table class="hh-table">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Role</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% users.forEach(u => { %>
                                        <tr>
                                            <td>
                                                <div class="hh-user-chip">
                                                    <div class="hh-avatar"><%= u.name.charAt(0).toUpperCase() %></div>
                                                    <div>
                                                        <strong><%= u.name %></strong>
                                                        <small>User account</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><%= u.email %></td>
                                            <td><span class="hh-role"><%= u.role %></span></td>
                                            <td>
                                                <a href="/admin/delete_user/<%= u._id %>" class="hh-btn-danger" style="min-height:40px; padding:0 14px;" onclick="return confirm('Delete this user?');">Delete</a>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="hh-empty">
                            <i class="bi bi-person-x"></i>
                            <h4>No users found</h4>
                            <p>There are no user records available right now.</p>
                        </div>
                    <% } %>
                </div>
            </section>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
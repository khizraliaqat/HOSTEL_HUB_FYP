<%- include('partials/header') %>

<style>
    :root {
        --hh-bg: #071120;
        --hh-bg-soft: #0b1730;
        --hh-white: #ffffff;
        --hh-text: #0f172a;
        --hh-text-soft: #64748b;
        --hh-line: rgba(255, 255, 255, 0.12);
        --hh-primary: #0ea5e9;
        --hh-secondary: #7c3aed;
        --hh-accent: #14b8a6;
        --hh-gold: #fbbf24;
        --hh-success: #10b981;
        --hh-shadow: 0 24px 60px rgba(2, 8, 23, 0.16);
    }

    body {
        background: #f8fafc;
        font-family: 'Outfit', sans-serif;
        overflow-x: hidden;
    }

    .hh-add-hostel-page {
        background:
            radial-gradient(circle at top left, rgba(14, 165, 233, 0.16), transparent 26%),
            radial-gradient(circle at top right, rgba(124, 58, 237, 0.16), transparent 24%),
            linear-gradient(180deg, #071120 0%, #0b1730 22%, #f8fafc 22%, #f8fafc 100%);
        min-height: 100vh;
        padding: 108px 0 72px;
    }

    .hh-shell {
        width: min(1240px, calc(100% - 32px));
        margin: 0 auto;
    }

    .hh-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.14);
        color: #dbeafe;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        backdrop-filter: blur(14px);
    }

    .hh-btn,
    .hh-btn-outline,
    .hh-btn-dark,
    .hh-btn-light {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 50px;
        padding: 0 18px;
        border-radius: 16px;
        font-weight: 800;
        text-decoration: none;
        transition: all 0.25s ease;
        border: 0;
        cursor: pointer;
    }

    .hh-btn {
        background: linear-gradient(135deg, var(--hh-primary) 0%, var(--hh-secondary) 100%);
        color: #ffffff;
        box-shadow: 0 16px 32px rgba(14, 165, 233, 0.18);
    }

    .hh-btn:hover {
        transform: translateY(-2px);
        color: #ffffff;
        box-shadow: 0 22px 38px rgba(14, 165, 233, 0.22);
    }

    .hh-btn-outline,
    .hh-btn-light {
        background: #ffffff;
        border: 1px solid #dbe4f0;
        color: #0f172a;
    }

    .hh-btn-dark {
        background: #0f172a;
        color: #ffffff;
    }

    .hh-btn-outline:hover,
    .hh-btn-dark:hover,
    .hh-btn-light:hover {
        transform: translateY(-2px);
    }

    .hh-hero {
        position: relative;
        border-radius: 36px;
        overflow: hidden;
        background: linear-gradient(180deg, #0c172c 0%, #101d3a 100%);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 24px 60px rgba(2, 8, 23, 0.2);
        color: #ffffff;
        padding: 34px;
        margin-bottom: 24px;
    }

    .hh-hero::before {
        content: '';
        position: absolute;
        width: 250px;
        height: 250px;
        right: -80px;
        top: -90px;
        border-radius: 999px;
        background: rgba(14, 165, 233, 0.14);
        filter: blur(36px);
        pointer-events: none;
    }

    .hh-hero-top {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        flex-wrap: wrap;
    }

    .hh-hero-copy h1 {
        margin: 18px 0 10px;
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(2.2rem, 5vw, 3.8rem);
        line-height: 1.02;
        letter-spacing: -0.05em;
        color: #ffffff;
    }

    .hh-hero-copy h1 .accent {
        background: linear-gradient(90deg, #8be7ff 0%, #39bdf8 42%, #8b5cf6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hh-hero-copy p {
        margin: 0;
        color: #c8d6f0;
        line-height: 1.85;
        max-width: 760px;
        font-size: 1rem;
    }

    .hh-hero-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-top: 26px;
        position: relative;
        z-index: 1;
    }

    .hh-stat {
        padding: 18px;
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(14px);
    }

    .hh-stat strong {
        display: block;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.5rem;
        line-height: 1;
        color: #ffffff;
        margin-bottom: 7px;
    }

    .hh-stat span {
        color: #c8d6f0;
        font-size: 0.88rem;
    }

    .hh-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(300px, 0.92fr);
        gap: 24px;
        align-items: start;
    }

    .hh-card,
    .hh-side-card {
        border-radius: 30px;
        background: #ffffff;
        border: 1px solid #e6eef8;
        box-shadow: var(--hh-shadow);
        overflow: hidden;
    }

    .hh-form-card {
        padding: 28px;
    }

    .hh-section-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0 0 18px;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.32rem;
        color: #0f172a;
    }

    .hh-section-title .icon {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, rgba(14, 165, 233, 0.1) 0%, rgba(124, 58, 237, 0.08) 100%);
        color: #0f172a;
    }

    .hh-form-grid {
        display: grid;
        gap: 18px;
    }

    .hh-form-grid.two {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hh-field label {
        display: block;
        margin-bottom: 8px;
        color: #64748b;
        font-size: 0.8rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .hh-field input,
    .hh-field textarea,
    .hh-field select {
        width: 100%;
        border: 1px solid #dbe4f0;
        border-radius: 16px;
        background: #ffffff;
        padding: 14px 16px;
        outline: none;
        color: #0f172a;
        font-family: 'Outfit', sans-serif;
        transition: all 0.25s ease;
    }

    .hh-field input:focus,
    .hh-field textarea:focus,
    .hh-field select:focus {
        border-color: #7dd3fc;
        box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.08);
    }

    .hh-field textarea {
        min-height: 110px;
        resize: vertical;
    }

    .hh-help {
        margin-top: 8px;
        color: #64748b;
        font-size: 0.84rem;
        line-height: 1.6;
    }

    .hh-highlight-box,
    .hh-facilities-box,
    .hh-upload-box,
    .hh-table-box {
        padding: 22px;
        border-radius: 24px;
        background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid #e6eef8;
    }

    .hh-highlight-box {
        background: linear-gradient(180deg, #eff6ff 0%, #f8fbff 100%);
        border: 1px dashed #7dd3fc;
    }

    .hh-chip-group {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 10px;
    }

    .hh-facility-input {
        display: none;
    }

    .hh-facility-label {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 14px;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid #dbe4f0;
        color: #0f172a;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.25s ease;
    }

    .hh-facility-input:checked + .hh-facility-label {
        background: #0f172a;
        color: #ffffff;
        border-color: #0f172a;
        box-shadow: 0 12px 24px rgba(2, 8, 23, 0.14);
    }

    .hh-table-wrap {
        overflow-x: auto;
        border-radius: 20px;
        border: 1px solid #e6eef8;
        background: #ffffff;
    }

    .hh-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 760px;
    }

    .hh-table thead {
        background: linear-gradient(135deg, #0ea5e9 0%, #7c3aed 100%);
        color: #ffffff;
    }

    .hh-table th,
    .hh-table td {
        padding: 14px 16px;
        text-align: center;
        border-bottom: 1px solid #edf2f7;
        vertical-align: middle;
    }

    .hh-table th {
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-weight: 800;
    }

    .hh-table td {
        color: #0f172a;
        font-size: 0.94rem;
        background: #ffffff;
    }

    .hh-table tbody tr:hover td {
        background: #f8fbff;
    }

    .hh-day-cell {
        font-weight: 800;
        font-family: 'Space Grotesk', sans-serif;
        background: #f8fafc !important;
        min-width: 120px;
    }

    .hh-mini-input {
        width: 100%;
        min-height: 42px;
        border: 1px solid #dbe4f0;
        border-radius: 14px;
        background: #f8fafc;
        padding: 0 12px;
        outline: none;
        color: #0f172a;
        font-family: 'Outfit', sans-serif;
        transition: all 0.25s ease;
    }

    .hh-mini-input:focus {
        border-color: #7dd3fc;
        box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.08);
        background: #ffffff;
    }

    .hh-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 22px;
    }

    .hh-side-card {
        position: sticky;
        top: 100px;
        padding: 24px;
        background: linear-gradient(180deg, #0c172c 0%, #101d3a 100%);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #ffffff;
    }

    .hh-side-card::before {
        content: '';
        position: absolute;
        width: 180px;
        height: 180px;
        right: -40px;
        top: -50px;
        border-radius: 999px;
        background: rgba(124, 58, 237, 0.16);
        filter: blur(28px);
        pointer-events: none;
    }

    .hh-side-head {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 18px;
    }

    .hh-side-icon {
        width: 56px;
        height: 56px;
        border-radius: 18px;
        display: grid;
        place-items: center;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #ffffff;
        font-size: 1.35rem;
        flex-shrink: 0;
    }

    .hh-side-head h3 {
        margin: 0 0 4px;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.2rem;
        color: #ffffff;
    }

    .hh-side-head p {
        margin: 0;
        color: #c8d6f0;
        font-size: 0.9rem;
    }

    .hh-side-points {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 12px;
    }

    .hh-point {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #dbeafe;
        font-weight: 600;
    }

    .hh-point i {
        width: 36px;
        height: 36px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: rgba(255, 255, 255, 0.08);
        color: #7dd3fc;
        flex-shrink: 0;
    }

    .hh-note {
        position: relative;
        z-index: 1;
        margin-top: 18px;
        padding: 16px;
        border-radius: 18px;
        background: rgba(251, 191, 36, 0.12);
        border: 1px solid rgba(251, 191, 36, 0.18);
        color: #fde68a;
        line-height: 1.7;
        font-size: 0.9rem;
    }

    @media (max-width: 1199px) {
        .hh-layout,
        .hh-form-grid.two {
            grid-template-columns: 1fr;
        }

        .hh-side-card {
            position: static;
        }
    }

    @media (max-width: 767px) {
        .hh-add-hostel-page {
            padding: 92px 0 54px;
        }

        .hh-shell {
            width: min(100% - 20px, 1240px);
        }

        .hh-hero,
        .hh-form-card,
        .hh-side-card,
        .hh-highlight-box,
        .hh-facilities-box,
        .hh-upload-box,
        .hh-table-box {
            padding: 18px;
        }

        .hh-hero-stats {
            grid-template-columns: 1fr;
        }

        .hh-table thead {
            display: none;
        }

        .hh-table,
        .hh-table tbody,
        .hh-table tr,
        .hh-table td {
            display: block;
            width: 100%;
        }

        .hh-table tr {
            padding: 14px;
            border-bottom: 1px solid #edf2f7;
        }

        .hh-table td {
            text-align: left;
            padding: 8px 0;
            border: none;
            background: transparent !important;
        }

        .hh-day-cell {
            font-size: 1rem;
            margin-bottom: 10px;
            padding-bottom: 10px !important;
            border-bottom: 1px solid #eee !important;
        }
    }

    @media (max-width: 575px) {
        .hh-hero-copy h1 {
            font-size: 2rem;
        }

        .hh-actions,
        .hh-hero-top {
            flex-direction: column;
            align-items: stretch;
        }

        .hh-btn,
        .hh-btn-outline,
        .hh-btn-dark,
        .hh-btn-light {
            width: 100%;
        }
    }
</style>

<div class="hh-add-hostel-page">
    <div class="hh-shell">
        <section class="hh-hero">
            <div class="hh-hero-top">
                <div class="hh-hero-copy">
                    <span class="hh-badge"><i class="bi bi-building-add"></i> property onboarding</span>
                    <h1>List your <span class="accent">property</span></h1>
                    <p>Create a full hostel listing with details, facilities, weekly mess plan, location embed, and images in one cleaner premium page. This redesign keeps the same form action, facilities logic, mess-plan structure, and upload flow intact. </p>
                </div>
            </div>

            <div class="hh-hero-stats">
                <div class="hh-stat">
                    <strong>5</strong>
                    <span>Max gallery photos</span>
                </div>
                <div class="hh-stat">
                    <strong>7</strong>
                    <span>Days in menu plan</span>
                </div>
                <div class="hh-stat">
                    <strong>PKR</strong>
                    <span>Local pricing kept</span>
                </div>
            </div>
        </section>

        <div class="hh-layout">
            <section class="hh-card">
                <div class="hh-form-card">
                    <form action="/add_hostel" method="POST" enctype="multipart/form-data">
                        <h3 class="hh-section-title"><span class="icon"><i class="bi bi-info-circle"></i></span> 1. Basic Details</h3>

                        <div class="hh-form-grid">
                            <div class="hh-field">
                                <label>Hostel Name</label>
                                <input type="text" name="name" required placeholder="e.g. Royal Boys Hostel">
                            </div>
                        </div>

                        <div class="hh-form-grid.two" style="margin-top:18px;">
                            <div class="hh-field">
                                <label>Category</label>
                                <select name="category" class="form-select">
                                    <option>Boys</option>
                                    <option>Girls</option>
                                    <option>Family</option>
                                </select>
                            </div>

                            <div class="hh-field">
                                <label>Area / City</label>
                                <input type="text" name="area" required placeholder="e.g. D-Ground">
                            </div>
                        </div>

                        <div class="hh-form-grid" style="margin-top:18px;">
                            <div class="hh-field">
                                <label>Monthly Rent (PKR)</label>
                                <input type="number" name="price" required placeholder="e.g. 15000">
                            </div>
                        </div>

                        <div style="margin-top:18px;">
                            <div class="hh-highlight-box">
                                <div class="hh-field">
                                    <label>Mess Fee / Food Charges (PKR) - Optional</label>
                                    <input type="number" name="mess_fee" placeholder="e.g. 5000, enter 0 or leave empty if no mess">
                                    <div class="hh-help">Use this for the separate monthly food-service charge, if available.</div>
                                </div>
                            </div>
                        </div>

                        <div style="margin-top:26px;">
                            <h3 class="hh-section-title"><span class="icon"><i class="bi bi-stars"></i></span> Facilities</h3>
                            <div class="hh-facilities-box">
                                <% const facs = ['WiFi','Mess','Laundry','Generator','CCTV','Parking']; %>
                                <div class="hh-chip-group" role="group">
                                    <% facs.forEach((f, i) => { %>
                                        <input type="checkbox" class="hh-facility-input" name="facilities[]" value="<%= f %>" id="f<%= i %>">
                                        <label class="hh-facility-label" for="f<%= i %>"><%= f %></label>
                                    <% }); %>
                                </div>
                            </div>
                        </div>

                        <div class="hh-form-grid" style="margin-top:26px;">
                            <div class="hh-field">
                                <label>Description</label>
                                <textarea name="desc" rows="3" placeholder="Tell students about your hostel..."></textarea>
                            </div>

                            <div class="hh-field">
                                <label>Google Maps Embed Code</label>
                                <textarea name="map_embed" rows="2" placeholder='Paste <iframe...> code here'></textarea>
                                <div class="hh-help">This field is optional. Add it only when you want the map to appear on the listing page.</div>
                            </div>
                        </div>

                        <div style="margin-top:28px;">
                            <h3 class="hh-section-title"><span class="icon"><i class="bi bi-egg-fried"></i></span> 2. Mess Menu (Weekly Plan)</h3>
                            <div class="hh-table-box">
                                <div class="hh-table-wrap">
                                    <table class="hh-table">
                                        <thead>
                                            <tr><th>Day</th><th>Breakfast</th><th>Lunch</th><th>Dinner</th></tr>
                                        </thead>
                                        <tbody>
                                            <% const days = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday']; %>
                                            <% days.forEach(d => { %>
                                                <tr>
                                                    <td class="hh-day-cell"><%= d %><input type="hidden" name="day[]" value="<%= d %>"></td>
                                                    <td><input type="text" name="bkf[]" class="hh-mini-input" placeholder="Dish..."></td>
                                                    <td><input type="text" name="lun[]" class="hh-mini-input" placeholder="Dish..."></td>
                                                    <td><input type="text" name="din[]" class="hh-mini-input" placeholder="Dish..."></td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div style="margin-top:28px;">
                            <h3 class="hh-section-title"><span class="icon"><i class="bi bi-images"></i></span> 3. Photos</h3>
                            <div class="hh-upload-box">
                                <div class="hh-field">
                                    <label>Select Images (Max 5)</label>
                                    <input type="file" name="images" multiple required accept="image/*">
                                    <div class="hh-help">Hold <strong>Ctrl</strong> to select multiple images and upload a cleaner gallery for the hostel listing.</div>
                                </div>
                            </div>
                        </div>

                        <div class="hh-actions">
                            <button type="submit" class="hh-btn"><i class="bi bi-check2-circle"></i> Save & Publish Hostel</button>
                        </div>
                    </form>
                </div>
            </section>

            <aside class="hh-side-card">
                <div class="hh-side-head">
                    <div class="hh-side-icon"><i class="bi bi-lightning-charge"></i></div>
                    <div>
                        <h3>Quick guidance</h3>
                        <p>Complete the listing with clear and useful details.</p>
                    </div>
                </div>

                <div class="hh-side-points">
                    <div class="hh-point"><i class="bi bi-tag"></i> Use a hostel name students can understand instantly</div>
                    <div class="hh-point"><i class="bi bi-cash-stack"></i> Keep rent and mess fee accurate in PKR</div>
                    <div class="hh-point"><i class="bi bi-stars"></i> Select only real facilities available on site</div>
                    <div class="hh-point"><i class="bi bi-camera"></i> Add clear images to build trust in the listing</div>
                </div>

                <div class="hh-note">
                    A complete listing with photos, facilities, and a weekly mess plan is easier for students to compare and book with confidence.
                </div>
            </aside>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
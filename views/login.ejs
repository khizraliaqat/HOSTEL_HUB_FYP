<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        :root {
            --primary: #0066CC;
            --primary-dark: #0052A3;
            --secondary: #00B8A9;
            --accent: #7C3AED;
            --dark-bg: #0F1419;
            --text-dark: #1A202C;
            --text-light: #718096;
            --border-light: #E5E7EB;
            --light-bg-secondary: #F3F4F6;
        }

        body {
            margin: 0; min-height: 100vh; display: flex; justify-content: center; align-items: center;
            background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 50%, var(--secondary) 100%);
            font-family: 'Outfit', sans-serif;
            padding: 20px;
        }
        
        .neo {
            width: 100%; max-width: 420px; padding: 42px; background: white; border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0, 102, 204, 0.2);
            border: none; color: var(--text-dark);
        }

        .neo h3 {
            font-family: 'Space Grotesk', sans-serif;
            color: var(--primary);
            font-weight: 700;
            font-size: 28px;
            letter-spacing: -0.5px;
        }

        .neo input {
            width: 100%; padding: 13px 16px; border-radius: 10px; border: 2px solid var(--border-light); background: var(--light-bg-secondary); color: var(--text-dark);
            box-shadow: none; margin-bottom: 16px;
            font-size: 15px; font-family: 'Outfit', sans-serif; font-weight: 500;
            transition: all 0.25s;
        }
        .neo input:focus {
            border-color: var(--primary);
            background: white;
            box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.08);
            outline: none;
        }
        .neo input::placeholder {
            color: var(--text-light);
        }

        .neo-btn {
            width: 100%; padding: 13px; border-radius: 10px; background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border: none; font-weight: 700; color: white; cursor: pointer; font-size: 15px; transition: all 0.3s;
            font-family: 'Outfit', sans-serif; letter-spacing: 0.3px;
            margin-top: 8px;
        }
        .neo-btn:hover {
            box-shadow: 0 12px 28px rgba(0, 102, 204, 0.3);
            transform: translateY(-2px);
        }
        .neo-btn:active {
            transform: translateY(0);
        }

        .auth-link {
            display: block; text-align: center; margin-top: 28px; text-decoration: none; color: var(--text-light);
            font-size: 14px; font-family: 'Outfit', sans-serif;
        }
        .auth-link span {
            color: var(--primary);
            font-weight: 600;
            cursor: pointer;
        }
        .auth-link:hover span {
            color: var(--primary-dark);
        }

        .alert {
            font-family: 'Outfit', sans-serif;
            border-radius: 12px;
            border: none;
            font-size: 14px;
            font-weight: 500;
        }

        /* Mobile Responsiveness */
        @media (max-width: 575.98px) {
            body {
                padding: 15px;
            }
            .neo {
                padding: 32px 24px;
                border-radius: 16px;
            }
            .neo h3 {
                font-size: 24px;
            }
            .neo input {
                padding: 12px 14px;
                margin-bottom: 14px;
                font-size: 14px;
            }
            .neo-btn {
                padding: 12px;
                font-size: 14px;
            }
            .auth-link {
                font-size: 13px;
                margin-top: 22px;
            }
        }
    </style>
</head>
<body>
    <div class="neo">
        <h3 class="text-center mb-4">Welcome Back</h3>
        
        <!-- EJS Error Handling -->
        <% if (error) { %>
            <div class="alert alert-danger py-3 mb-4 text-center">
                <i class="bi bi-exclamation-circle me-2"></i><%= error %>
            </div>
        <% } %>

        <% if (msg) { %>
            <div class="alert alert-success py-3 mb-4 text-center">
                <%= msg %>
            </div>
        <% } %>

        <form method="POST" action="/login">
            <input type="email" name="email" placeholder="Email Address" required>
            <input type="password" name="password" placeholder="Password" required>
            <button type="submit" class="neo-btn">LOGIN</button>
        </form>

        <a href="/forgot_password" class="auth-link" style="margin-top:14px;">
            Forgot password? <span>Reset it</span>
        </a>

        <a href="/register" class="auth-link">
            Don't have an account? <span>Sign Up</span>
        </a>
    </div>
</body>
</html>
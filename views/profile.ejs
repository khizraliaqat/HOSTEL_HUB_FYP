<%- include('partials/header') %>

<style>
:root {
    --hh-bg: #071120;
    --hh-bg-soft: #0b1730;
    --hh-white: #ffffff;
    --hh-text: #0f172a;
    --hh-text-soft: #64748b;
    --hh-line: rgba(255, 255, 255, 0.12);
    --hh-primary: #0ea5e9;
    --hh-secondary: #7c3aed;
    --hh-accent: #14b8a6;
    --hh-gold: #fbbf24;
    --hh-success: #10b981;
    --hh-danger: #ef4444;
    --hh-shadow: 0 24px 60px rgba(2, 8, 23, 0.16);
}

body {
    background: #f8fafc;
    font-family: 'Outfit', sans-serif;
    overflow-x: hidden;
}

.hh-profile-page {
    background:
        radial-gradient(circle at top left, rgba(14, 165, 233, 0.16), transparent 26%),
        radial-gradient(circle at top right, rgba(124, 58, 237, 0.16), transparent 24%),
        linear-gradient(180deg, #071120 0%, #0b1730 22%, #f8fafc 22%, #f8fafc 100%);
    min-height: 100vh;
    padding: 108px 0 72px;
}

.hh-shell {
    width: min(1320px, calc(100% - 32px));
    margin: 0 auto;
}

.hh-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #dbeafe;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    backdrop-filter: blur(14px);
}

.hh-hero {
    position: relative;
    border-radius: 36px;
    overflow: hidden;
    background: linear-gradient(180deg, #0c172c 0%, #101d3a 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 24px 60px rgba(2, 8, 23, 0.2);
    color: #ffffff;
    padding: 34px;
    margin-bottom: 24px;
}

.hh-hero::before {
    content: '';
    position: absolute;
    width: 240px;
    height: 240px;
    right: -70px;
    top: -90px;
    border-radius: 999px;
    background: rgba(14, 165, 233, 0.14);
    filter: blur(36px);
    pointer-events: none;
}

.hh-hero-top {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 18px;
    flex-wrap: wrap;
}

.hh-hero-copy h1 {
    margin: 18px 0 10px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.02;
    letter-spacing: -0.05em;
    color: #ffffff;
}

.hh-hero-copy h1 .accent {
    background: linear-gradient(90deg, #8be7ff 0%, #39bdf8 42%, #8b5cf6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hh-hero-copy p {
    margin: 0;
    color: #c8d6f0;
    line-height: 1.85;
    max-width: 720px;
    font-size: 1rem;
}

.hh-top-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 26px;
    position: relative;
    z-index: 1;
}

.hh-stat {
    padding: 18px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(14px);
}

.hh-stat strong {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.55rem;
    line-height: 1;
    color: #ffffff;
    margin-bottom: 7px;
}

.hh-stat span {
    color: #c8d6f0;
    font-size: 0.88rem;
}

.hh-layout {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
}

.hh-sidebar,
.hh-content-panel,
.hh-profile-card,
.hh-content-card {
    border-radius: 30px;
    overflow: hidden;
    box-shadow: var(--hh-shadow);
}

.hh-sidebar {
    position: sticky;
    top: 100px;
    background: linear-gradient(180deg, #0c172c 0%, #101d3a 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #ffffff;
    padding: 20px;
}

.hh-sidebar-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 18px;
}

.hh-mini-avatar {
    width: 52px;
    height: 52px;
    border-radius: 18px;
    overflow: hidden;
    flex-shrink: 0;
    border: 2px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.08);
}

.hh-mini-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.hh-mini-meta strong {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    color: #ffffff;
    font-size: 1rem;
    margin-bottom: 4px;
}

.hh-mini-meta span {
    color: #8be7ff;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.hh-nav {
    display: grid;
    gap: 10px;
}

.hh-nav-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 52px;
    padding: 0 16px;
    border-radius: 16px;
    border: 0;
    background: transparent;
    color: #c8d6f0;
    font-weight: 700;
    text-align: left;
    transition: all 0.25s ease;
}

.hh-nav-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
}

.hh-nav-btn.active {
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.22) 0%, rgba(124, 58, 237, 0.18) 100%);
    color: #ffffff;
    border: 1px solid rgba(125, 211, 252, 0.28);
    box-shadow: 0 14px 26px rgba(14, 165, 233, 0.12);
}

.hh-content-panel {
    display: grid;
    gap: 20px;
}

.hh-profile-card {
    background: #ffffff;
    border: 1px solid #e6eef8;
    padding: 24px;
}

.hh-profile-top {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
}

.hh-avatar-wrap {
    position: relative;
    width: 112px;
    height: 112px;
    flex: 0 0 112px;
}

.hh-avatar {
    width: 112px;
    height: 112px;
    border-radius: 28px;
    overflow: hidden;
    border: 3px solid #ffffff;
    box-shadow: 0 18px 34px rgba(2, 8, 23, 0.14);
    background: linear-gradient(135deg, #eff6ff 0%, #f8fafc 100%);
}

.hh-avatar img,
.hh-avatar .placeholder-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.hh-avatar-edit {
    position: absolute;
    right: 8px;
    bottom: 8px;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 2px solid #ffffff;
    background: linear-gradient(135deg, var(--hh-primary) 0%, var(--hh-secondary) 100%);
    color: #ffffff;
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: 0 10px 20px rgba(2, 8, 23, 0.16);
}

.hh-profile-meta h2 {
    margin: 0 0 8px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.7rem;
    color: #0f172a;
}

.hh-role-pill {
    display: inline-flex;
    padding: 8px 12px;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.12) 0%, rgba(124, 58, 237, 0.1) 100%);
    color: #1d4ed8;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.78rem;
    margin-bottom: 10px;
}

.hh-profile-meta p {
    margin: 0;
    color: #64748b;
    line-height: 1.85;
    max-width: 760px;
}

.hh-card-stats {
    display: flex;
    gap: 12px;
    margin-top: 16px;
    flex-wrap: wrap;
}

.hh-card-stat {
    min-width: 132px;
    padding: 14px 16px;
    border-radius: 18px;
    background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    border: 1px solid #e6eef8;
    box-shadow: 0 10px 22px rgba(2, 8, 23, 0.05);
}

.hh-card-stat strong {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.12rem;
    color: #0f172a;
    margin-bottom: 6px;
}

.hh-card-stat span {
    color: #64748b;
    font-size: 0.82rem;
}

.hh-content-card {
    background: #ffffff;
    border: 1px solid #e6eef8;
    padding: 24px;
}

.hh-content-card h3 {
    margin: 0 0 18px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.4rem;
    color: #0f172a;
}

.hh-form-grid {
    display: grid;
    gap: 18px;
}

.hh-form-grid.two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.hh-field label {
    display: block;
    margin-bottom: 8px;
    color: #64748b;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

.hh-field input,
.hh-field textarea,
.hh-field select {
    width: 100%;
    border: 1px solid #dbe4f0;
    border-radius: 16px;
    background: #ffffff;
    padding: 14px 16px;
    outline: none;
    color: #0f172a;
    font-family: 'Outfit', sans-serif;
    transition: all 0.25s ease;
}

.hh-field input:focus,
.hh-field textarea:focus,
.hh-field select:focus {
    border-color: #7dd3fc;
    box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.08);
}

.hh-field textarea {
    min-height: 120px;
    resize: vertical;
}

.hh-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    flex-wrap: wrap;
}

.hh-btn,
.hh-btn-outline,
.hh-btn-dark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 50px;
    padding: 0 18px;
    border-radius: 16px;
    border: 0;
    font-weight: 800;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.25s ease;
}

.hh-btn {
    background: linear-gradient(135deg, var(--hh-primary) 0%, var(--hh-secondary) 100%);
    color: #ffffff;
    box-shadow: 0 16px 32px rgba(14, 165, 233, 0.18);
}

.hh-btn:hover {
    transform: translateY(-2px);
    color: #ffffff;
    box-shadow: 0 22px 38px rgba(14, 165, 233, 0.22);
}

.hh-btn-outline {
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #dbe4f0;
}

.hh-btn-dark {
    background: #0f172a;
    color: #ffffff;
}

.hh-btn-outline:hover,
.hh-btn-dark:hover {
    transform: translateY(-2px);
}

.hh-verify-box {
    padding: 24px;
    border-radius: 24px;
    background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    border: 1px solid #e6eef8;
}

.hh-verify-top {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
}

.hh-verify-icon {
    width: 62px;
    height: 62px;
    border-radius: 20px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.12) 0%, rgba(124, 58, 237, 0.08) 100%);
    color: #0f172a;
    font-size: 1.5rem;
    flex-shrink: 0;
}

.hh-verify-top h4 {
    margin: 0 0 6px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.16rem;
    color: #0f172a;
}

.hh-verify-top p {
    margin: 0;
    color: #64748b;
    line-height: 1.8;
}

.hh-activity-list {
    display: grid;
    gap: 12px;
}

.hh-activity-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    border-radius: 18px;
    background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    border: 1px solid #e6eef8;
}

.hh-activity-item i {
    width: 40px;
    height: 40px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.12) 0%, rgba(124, 58, 237, 0.08) 100%);
    color: #0f172a;
    flex-shrink: 0;
}

.hh-activity-item strong {
    display: block;
    color: #0f172a;
    margin-bottom: 4px;
}

.hh-activity-item p {
    margin: 0;
    color: #64748b;
    line-height: 1.75;
}

.hh-mobile-nav {
    display: none;
    margin-bottom: 16px;
}

.hh-mobile-nav .hh-select {
    width: 100%;
    min-height: 50px;
    padding: 0 16px;
    border-radius: 16px;
    border: 1px solid #dbe4f0;
    background: #ffffff;
    color: #0f172a;
    font-weight: 700;
    outline: none;
}

@media (max-width: 1199px) {
    .hh-layout {
        grid-template-columns: 1fr;
    }

    .hh-sidebar {
        position: static;
    }
}

@media (max-width: 767px) {
    .hh-profile-page {
        padding: 92px 0 54px;
    }

    .hh-shell {
        width: min(100% - 20px, 1320px);
    }

    .hh-hero,
    .hh-sidebar,
    .hh-profile-card,
    .hh-content-card,
    .hh-verify-box {
        padding: 18px;
    }

    .hh-form-grid.two,
    .hh-top-stats {
        grid-template-columns: 1fr;
    }

    .hh-mobile-nav {
        display: block;
    }

    .hh-sidebar {
        display: none;
    }
}

@media (max-width: 575px) {
    .hh-hero-copy h1 {
        font-size: 2rem;
    }

    .hh-profile-top,
    .hh-actions,
    .hh-hero-top {
        flex-direction: column;
        align-items: stretch;
    }

    .hh-btn,
    .hh-btn-outline,
    .hh-btn-dark {
        width: 100%;
    }
}
</style>

<div class="hh-profile-page">
  <div class="hh-shell">

    <section class="hh-hero">
        <div class="hh-hero-top">
            <div class="hh-hero-copy">
                <span class="hh-badge"><i class="bi bi-person-circle"></i> account center</span>
                <h1>Manage your <span class="accent">profile</span></h1>
                <p>Update your personal details, manage password security, submit verification documents, and keep your account information organized in one cleaner premium layout.</p>
            </div>
        </div>

        <div class="hh-top-stats">
            <div class="hh-stat">
                <strong><%= user.role === 'owner' ? 'Owner' : 'User' %></strong>
                <span>Account type</span>
            </div>
            <div class="hh-stat">
                <strong><%= new Date(user.created_at).getFullYear() %></strong>
                <span>Member since</span>
            </div>
            <div class="hh-stat">
                <strong><%= user.is_id_verified ? 'Yes' : 'No' %></strong>
                <span>ID verified</span>
            </div>
        </div>
    </section>

    <% if (msg) { %>
        <% const errorCodes = ['profile_update_error', 'password_fields_required', 'password_mismatch', 'weak_password', 'current_password_incorrect', 'password_update_error']; %>
        <div class="alert <%= errorCodes.includes(msgCode) ? 'alert-danger' : 'alert-success' %> rounded-4 border-0 shadow-sm mb-4" role="alert">
            <%= msg %>
        </div>
    <% } %>

    <div class="hh-mobile-nav">
        <select class="hh-select" id="mobilePanelSelect">
            <option value="info">Info</option>
            <option value="security">Security</option>
            <option value="verification">Verification</option>
            <option value="activity">Activity</option>
        </select>
    </div>

    <div class="hh-layout">
        <aside class="hh-sidebar">
            <div class="hh-sidebar-head">
                <div class="hh-mini-avatar">
                    <% if(user.profile_pic) { %>
                        <img src="/uploads/<%= user.profile_pic %>" alt="<%= user.name %>">
                    <% } else { %>
                        <div class="placeholder-img placeholder-avatar" style="width:100%;height:100%;"></div>
                    <% } %>
                </div>
                <div class="hh-mini-meta">
                    <strong><%= user.name %></strong>
                    <span><%= user.role.toUpperCase() %></span>
                </div>
            </div>

            <div class="hh-nav" role="tablist" aria-orientation="vertical">
                <button class="hh-nav-btn active" data-target="info"><i class="bi bi-person-lines-fill"></i> Info</button>
                <button class="hh-nav-btn" data-target="security"><i class="bi bi-shield-lock"></i> Security</button>
                <button class="hh-nav-btn" data-target="verification"><i class="bi bi-patch-check"></i> Verification</button>
                <button class="hh-nav-btn" data-target="activity"><i class="bi bi-clock-history"></i> Activity</button>
            </div>
        </aside>

        <div class="hh-content-panel">
            <div class="hh-profile-card">
                <div class="hh-profile-top">
                    <div class="hh-avatar-wrap">
                        <div class="hh-avatar" id="avatarPreviewWrap">
                            <% if(user.profile_pic) { %>
                                <img id="avatarPreview" src="/uploads/<%= user.profile_pic %>" alt="avatar">
                            <% } else { %>
                                <div id="avatarPreviewPlaceholder" class="placeholder-img placeholder-avatar" style="width:100%;height:100%;"></div>
                                <img id="avatarPreview" src="" alt="avatar" style="display:none;">
                            <% } %>
                        </div>
                        <label for="picInput" class="hh-avatar-edit" title="Change photo">
                            <i class="bi bi-pencil-fill"></i>
                        </label>
                    </div>

                    <div class="hh-profile-meta">
                        <h2><%= user.name %></h2>
                        <span class="hh-role-pill"><%= user.role.toUpperCase() %></span>
                        <p><%= user.about || 'Add a short bio to let others know more about you.' %></p>

                        <div class="hh-card-stats">
                            <div class="hh-card-stat">
                                <strong><%= user.role === 'owner' ? 'Properties' : 'Bookings' %></strong>
                                <span>Account section</span>
                            </div>
                            <div class="hh-card-stat">
                                <strong><%= new Date(user.created_at).getFullYear() %></strong>
                                <span>Member since</span>
                            </div>
                            <div class="hh-card-stat">
                                <strong><%= user.is_id_verified ? 'Verified' : 'Pending' %></strong>
                                <span>Verification status</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="panel-info" class="hh-content-card">
                <h3>Personal Information</h3>
                <form id="profileForm" action="/update_profile" method="POST" enctype="multipart/form-data">
                    <input id="picInput" name="profile_pic" type="file" accept="image/*" class="d-none" onchange="previewImage(this)">

                    <div class="hh-form-grid two">
                        <div class="hh-field">
                            <label>Full Name</label>
                            <input name="name" value="<%= user.name %>" required>
                        </div>
                        <div class="hh-field">
                            <label>Email, Read Only</label>
                            <input value="<%= user.email %>" readonly>
                        </div>
                        <div class="hh-field">
                            <label>Phone</label>
                            <input name="phone" value="<%= user.phone || '' %>">
                        </div>
                        <div class="hh-field">
                            <label>City</label>
                            <input value="<%= user.city || 'Faisalabad' %>" readonly>
                        </div>
                    </div>

                    <div class="hh-form-grid" style="margin-top:18px;">
                        <div class="hh-field">
                            <label>About / Bio</label>
                            <textarea name="about"><%= user.about || '' %></textarea>
                        </div>
                    </div>

                    <div class="hh-actions" style="margin-top:18px;">
                        <button type="button" class="hh-btn-outline" onclick="resetForm()">Cancel</button>
                        <button type="submit" class="hh-btn-dark">Save Profile</button>
                    </div>
                </form>
            </div>

            <div id="panel-security" class="hh-content-card" style="display:none;">
                <h3>Change Password</h3>
                <form action="/change_password" method="POST">
                    <div class="hh-form-grid">
                        <div class="hh-field">
                            <label>Current Password</label>
                            <input name="current_password" type="password" required>
                        </div>
                        <div class="hh-form-grid two">
                            <div class="hh-field">
                                <label>New Password</label>
                                <input name="new_password" type="password" required>
                            </div>
                            <div class="hh-field">
                                <label>Confirm Password</label>
                                <input name="confirm_password" type="password" required>
                            </div>
                        </div>
                        <small style="color:#64748b;">Use at least 8 characters with uppercase, lowercase, number, and special character.</small>
                    </div>
                    <div class="hh-actions" style="margin-top:18px;">
                        <button type="submit" class="hh-btn-dark">Update Password</button>
                    </div>
                </form>
            </div>

            <div id="panel-verification" class="hh-content-card" style="display:none;">
                <h3>Identity Verification</h3>

                <% if (user.is_id_verified) { %>
                    <div class="hh-verify-box">
                        <div class="hh-verify-top">
                            <div class="hh-verify-icon"><i class="bi bi-shield-check"></i></div>
                            <div>
                                <h4>Verified</h4>
                                <p>Your identity verification has already been completed successfully.</p>
                            </div>
                        </div>
                    </div>
                <% } else { %>
                    <div class="hh-verify-box">
                        <div class="hh-verify-top">
                            <div class="hh-verify-icon"><i class="bi bi-person-badge"></i></div>
                            <div>
                                <h4>Not Verified Yet</h4>
                                <p>Upload your CNIC or ID image to submit a verification request for your profile.</p>
                            </div>
                        </div>

                        <form action="/upload_cnic" method="POST" enctype="multipart/form-data">
                            <div class="hh-form-grid two">
                                <div class="hh-field">
                                    <label>Upload CNIC / ID</label>
                                    <input type="file" name="cnic" accept="image/*" required>
                                </div>
                            </div>
                            <div class="hh-actions" style="margin-top:18px;">
                                <button type="submit" class="hh-btn">Submit Verification</button>
                            </div>
                        </form>
                    </div>
                <% } %>
            </div>

            <div id="panel-activity" class="hh-content-card" style="display:none;">
                <h3>Recent Activity</h3>
                <div class="hh-activity-list">
                    <div class="hh-activity-item">
                        <i class="bi bi-person-check"></i>
                        <div>
                            <strong>Profile Overview</strong>
                            <p>Recent logins, account updates, and booking-related actions will appear here when activity tracking is enabled.</p>
                        </div>
                    </div>
                    <div class="hh-activity-item">
                        <i class="bi bi-shield-lock"></i>
                        <div>
                            <strong>Security Updates</strong>
                            <p>Password changes and verification actions can be surfaced in this section for better account visibility.</p>
                        </div>
                    </div>
                    <div class="hh-activity-item">
                        <i class="bi bi-clock-history"></i>
                        <div>
                            <strong>No Recent Activity</strong>
                            <p>There is no recent activity available right now.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
  </div>
</div>

<script>
function previewImage(input) {
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            const img = document.getElementById('avatarPreview');
            const placeholder = document.getElementById('avatarPreviewPlaceholder');
            if (img) {
                img.src = e.target.result;
                img.style.display = 'block';
            }
            if (placeholder) {
                placeholder.style.display = 'none';
            }
        };
        reader.readAsDataURL(input.files[0]);
    }
}

const navBtns = document.querySelectorAll('.hh-nav-btn');
const mobileSelect = document.getElementById('mobilePanelSelect');
const panels = {
    info: document.getElementById('panel-info'),
    security: document.getElementById('panel-security'),
    verification: document.getElementById('panel-verification'),
    activity: document.getElementById('panel-activity')
};

function switchPanel(target) {
    navBtns.forEach(btn => btn.classList.remove('active'));
    Object.values(panels).forEach(panel => panel.style.display = 'none');

    const activeBtn = document.querySelector('.hh-nav-btn[data-target="' + target + '"]');
    if (activeBtn) activeBtn.classList.add('active');
    if (panels[target]) panels[target].style.display = 'block';
    if (mobileSelect) mobileSelect.value = target;
}

navBtns.forEach(btn => {
    btn.addEventListener('click', () => switchPanel(btn.dataset.target));
});

if (mobileSelect) {
    mobileSelect.addEventListener('change', function() {
        switchPanel(this.value);
    });
}

function resetForm() {
    document.getElementById('profileForm').reset();
}
</script>


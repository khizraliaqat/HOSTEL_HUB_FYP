<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - HostelHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        :root {
            --primary: #0066CC;
            --primary-dark: #0052A3;
            --secondary: #00B8A9;
            --accent: #7C3AED;
            --text-dark: #1A202C;
            --text-light: #718096;
            --border-light: #E5E7EB;
            --light-bg-secondary: #F3F4F6;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, var(--accent) 0%, var(--primary) 55%, var(--secondary) 100%);
            font-family: 'Outfit', sans-serif;
            padding: 20px;
        }

        .card-shell {
            width: 100%;
            max-width: 460px;
            padding: 40px;
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 25px 65px rgba(28, 42, 72, 0.22);
        }

        h3 {
            font-family: 'Space Grotesk', sans-serif;
            color: var(--primary);
            font-weight: 700;
            font-size: 28px;
            letter-spacing: -0.5px;
            margin-bottom: 14px;
        }

        p {
            margin: 0 0 18px;
            color: var(--text-light);
            line-height: 1.7;
            font-size: 0.94rem;
        }

        input {
            width: 100%;
            padding: 13px 16px;
            border-radius: 10px;
            border: 2px solid var(--border-light);
            background: var(--light-bg-secondary);
            color: var(--text-dark);
            font-size: 15px;
            font-family: 'Outfit', sans-serif;
            font-weight: 500;
            transition: all 0.25s;
            margin-bottom: 14px;
        }

        input:focus {
            border-color: var(--primary);
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.08);
            outline: none;
        }

        .btn-primary-solid {
            width: 100%;
            padding: 13px;
            border-radius: 10px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border: none;
            color: #ffffff;
            font-weight: 700;
            font-size: 15px;
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 4px;
        }

        .btn-primary-solid:hover {
            box-shadow: 0 12px 28px rgba(0, 102, 204, 0.3);
            transform: translateY(-2px);
        }

        .auth-link {
            display: block;
            text-align: center;
            margin-top: 22px;
            text-decoration: none;
            color: var(--text-light);
            font-size: 14px;
        }

        .auth-link span {
            color: var(--primary);
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="card-shell">
        <h3 class="text-center">Reset Password</h3>

        <% if (!token) { %>
            <div class="alert alert-danger py-3 mb-3 text-center">Reset link is invalid or expired.</div>
            <a href="/forgot_password" class="auth-link">Request a new <span>reset link</span></a>
        <% } else { %>
            <p class="text-center">Create a new strong password for your account.</p>

            <% if (error) { %>
                <div class="alert alert-danger py-3 mb-3 text-center"><%= error %></div>
            <% } %>

            <% if (msg) { %>
                <div class="alert alert-success py-3 mb-3 text-center"><%= msg %></div>
            <% } %>

            <form method="POST" action="/reset_password/<%= token %>">
                <input type="password" name="password" placeholder="New Password" required>
                <input type="password" name="confirm_password" placeholder="Confirm New Password" required>
                <button type="submit" class="btn-primary-solid">Update Password</button>
            </form>

            <a href="/login" class="auth-link">Back to <span>Login</span></a>
        <% } %>
    </div>
</body>
</html>
